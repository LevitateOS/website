{
  "version": 3,
  "name": "Field Notes",
  "status": "implementation baseline",
  "color": {
    "paper": "#F2EEE4",
    "pine": "#214438",
    "ink": "#14221A",
    "red": "#B22F27",
    "redHover": "#95271F",
    "acornBrown": "#644532",
    "line": "#BFC6B8"
  },
  "foregroundPairs": {
    "reading": [
      "ink",
      "paper"
    ],
    "levitate": [
      "pine",
      "paper"
    ],
    "acorn": [
      "acornBrown",
      "paper"
    ],
    "primaryAction": [
      "paper",
      "red"
    ],
    "primaryActionHover": [
      "paper",
      "redHover"
    ],
    "darkEnding": [
      "paper",
      "pine"
    ]
