  "typography": {
    "editorial": {
      "family": "Newsreader",
      "weights": [
        400,
        500
      ],
      "italic": true,
      "opticalSizing": "auto"
    },
    "interface": {
      "family": "Instrument Sans",
      "weights": [
        400,
        500
      ]
    },
    "hero": {
      "size": "clamp(42px,9.7cqi,100px)",
      "lineHeight": 0.94,
      "letterSpacing": "-0.045em"
    },
    "labelMinimumPx": 11,
    "bodyRangePx": [
      14,
      17
    ]
  },
  "spacingPx": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64
  ],
  "geometry": {
    "cornerRadiusPx": 0,
    "controlTargetMinimumPx": 44,
