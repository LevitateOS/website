---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import CodeBlock from "../components/CodeBlock.astro";
import AnimatedSection from "../components/AnimatedSection.astro";
import CheckList from "../components/CheckList.astro";
import ScrollIndicator from "../components/ScrollIndicator.astro";
import SectionHeader from "../components/SectionHeader.astro";
import OSCard from "../components/OSCard.astro";
import SplitSection from "../components/SplitSection.astro";
import CTAButtons from "../components/CTAButtons.astro";
import HighlightBox from "../components/HighlightBox.astro";
import LevitateTextLogo from "../components/brand/LevitateTextLogo.astro";

const recipeAdvantages = [
  "Pin exact versions — downloads need a SHA-256, git checkouts a full commit",
  "Read the build logic in seconds — it's just Rhai script",
  "Add patches directly — your recipes, your rules",
  "Every build runs isolated, never on your running system",
];

const updateSteps = [
  "The next system is written to the inactive slot",
  "It boots once as a trial, and is kept only if it comes up healthy",
  "A failed trial lands you back on the slot you came from",
  "Roll back later with one command and a reboot",
];

const recipeCode = `// recipes/ripgrep.rhai
const RECIPE_API = 2;

let ctx = #{
    name: "ripgrep",
    version: "14.1.1",
    url: "https://github.com/BurntSushi/ripgrep/archive/14.1.1.tar.gz",
    sha256: "<pinned sha256>",
    src: join_path(RUNTIME.paths.build, "ripgrep-14.1.1"),
    bin: join_path(RUNTIME.paths.output, "usr/bin/rg"),
};

fn is_acquired(ctx) {
    if !is_file(join_path(ctx.src, "Cargo.toml")) {
        return needs_work(ctx, "source not unpacked");
    }
    ready(ctx)
}

fn acquire(ctx) {
    let dest = join_path(ctx.runtime.paths.build, "ripgrep.tar.gz");
    extract(download(ctx.url, dest, ctx.sha256), ctx.runtime.paths.build);
    ctx
}

fn is_built(ctx) {
    if !is_file(join_path(ctx.src, "target/release/rg")) {
        return needs_work(ctx, "rg not built");
    }
    ready(ctx)
}

fn build(ctx) {
    shell_in(ctx.src, "cargo build --release --locked");
    ctx
}

fn is_installed(ctx) {
    if !is_file(ctx.bin) { return needs_work(ctx, "rg not installed"); }
    ctx.outputs.rg = ctx.bin;
    ready(ctx)
}

fn install(ctx) {
    mkdir(dirname(ctx.bin));
    copy_file(join_path(ctx.src, "target/release/rg"), ctx.bin);
    chmod(ctx.bin, 0o755);
    ctx.outputs.rg = ctx.bin;
    ctx
}`;

const updateCode = `# running from slot A
$ recab stage --rootfs next.erofs \\
      --kernel vmlinuz --initrd initramfs.img
$ recab set-next B
$ reboot

# B boots once as a trial:
# healthy -> committed, B is the new default
# not     -> back to A, nothing lost

$ recab rollback    # any time, while A still holds its system`;

const docsFeatures = [
  '<strong class="text-foreground">Code</strong> on the left',
  '<strong class="text-foreground">Documentation</strong> on the right',
  '<strong class="text-foreground">Context</strong> exactly when you need it',
];
---

<BaseLayout
  title="LevitateOS - A Linux Distribution You Actually Control"
  description="Linux you control end-to-end: recipe-built packages built in isolation, atomic A/B updates by default, rollback in one reboot. Mutable mode exists for daredevils."
>
  <div class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <!-- Hero -->
      <section
        id="hero"
        class="relative min-h-[85vh] flex flex-col items-center justify-center text-center py-12"
      >
        <div class="container flex flex-col items-center max-w-3xl">
          <AnimatedSection>
            <div class="logo-relief mb-6">
              <img
                id="hero-logo"
                src="/levitateos-trace-light.svg"
                data-dark-src="/levitateos-trace.svg"
                data-light-src="/levitateos-trace-light.svg"
                alt="LevitateOS"
                width="192"
                height="192"
                class="w-36 sm:w-40 lg:w-48 h-auto"
              />
            </div>
          </AnimatedSection>

          <AnimatedSection delay={25}>
            <LevitateTextLogo className="text-3xl sm:text-4xl mb-4" />
          </AnimatedSection>

          <AnimatedSection delay={50}>
            <p
              class="text-sm font-medium text-primary uppercase tracking-widest mb-3"
            >
              Be your own package maintainer
            </p>
          </AnimatedSection>

          <AnimatedSection delay={150}>
            <h1
              class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight"
            >
              Customization from the <span class="text-primary"
                >package level</span
              >.
            </h1>
          </AnimatedSection>

          <AnimatedSection delay={250} class="mt-5 max-w-2xl">
            <p class="text-sm text-muted-foreground leading-relaxed">
              Make your own package repository. While other Linux distributions
              rely on centralized repositories, here we take the slow route. You
              write your own packages named "recipes": declaring how to acquire,
              build and install each piece of software.
            </p>
          </AnimatedSection>

          <AnimatedSection delay={300} class="mt-3 max-w-2xl">
            <p class="text-sm text-muted-foreground leading-relaxed">
              Atomic A/B updates by default. The next system is written to the
              other slot and boots once as a trial: kept if it comes up healthy,
              back to the old one if not. Roll back by rebooting.
            </p>
          </AnimatedSection>

          <AnimatedSection delay={350} class="mt-3 max-w-2xl">
            <p class="text-sm text-muted-foreground leading-relaxed">
              Every recipe builds inside an isolated Ginux domain. It sees only
              the inputs you hand it, every download is pinned by checksum, and
              nothing it does touches your running system.
            </p>
          </AnimatedSection>

          <AnimatedSection delay={450} class="mt-6">
            <p class="text-lg font-medium">
              Immutable by default. Full control. <span class="text-primary"
                >Isolated builds</span
              >.
            </p>
          </AnimatedSection>

          <AnimatedSection delay={550} class="mt-6">
            <CTAButtons
              primaryHref="#recipe"
              primaryText="See How It Works"
              secondaryHref="https://github.com/LevitateOS/LevitateOS"
              secondaryText="GitHub"
              centered={true}
            />
          </AnimatedSection>
        </div>

        <ScrollIndicator />
      </section>

      <!-- Variants -->
      <section id="flavors" class="py-16 section-surface">
        <div class="container max-w-4xl">
          <div class="text-center mb-8">
            <h2 class="text-2xl sm:text-3xl font-medium mb-3">
              Two Variants. One Recipe System.
            </h2>
            <p class="text-muted-foreground text-sm max-w-2xl mx-auto">
              Two bases built by the same pipeline. A/B immutable by default.
              Mutable mode is optional.
            </p>
          </div>

          <div class="grid md:grid-cols-2 gap-6">
            <OSCard
              variant="levitate"
              name="LevitateOS"
              stack="glibc / systemd / GNU"
              description="Maximum software compatibility. If it runs on Linux, it runs here. Systemd handles services, timers, and boot."
              features={[
                "Broadest package compatibility",
                "Comprehensive service management",
                "Core system from signed Fedora 45 RPMs",
                "Familiar to most Linux users",
              ]}
              logo="/levitateos-trace.svg"
            />

            <OSCard
              variant="acorn"
              name="AcornOS"
              stack="musl / OpenRC / busybox"
              description="A mirror build of LevitateOS with a different toolchain. Smaller binaries, faster boot, simpler init. For those who prefer knowing exactly what's running on their system."
              features={[
                "Leaner compiled binaries",
                "Straightforward init scripts",
                "Core system from Alpine Linux APKs",
                "Less complexity under the hood",
              ]}
              logo="/acorn-trace.svg"
            />
          </div>
        </div>
      </section>

      <!-- Recipe System -->
      <section id="recipe" class="py-16">
        <div class="container max-w-4xl">
          <SplitSection>
            <SectionHeader title="Recipes, Not Repositories" />
            <p class="text-muted-foreground text-sm mb-3">
              Instead of <code class="bg-muted px-1.5 py-0.5">apt</code> or <code
                class="bg-muted px-1.5 py-0.5">dnf</code
              >, LevitateOS uses <code class="bg-muted px-1.5 py-0.5"
                >recipe</code
              >.
            </p>
            <p class="text-muted-foreground text-sm mb-4">
              A recipe is a <code class="bg-muted px-1.5 py-0.5"
                >.rhai</code
              > script that describes how to acquire, build, and install a package.
              Rhai is a small scripting language embedded in Rust, readable in
              seconds. Each step checks the real files before it runs, so an
              interrupted build picks up where it stopped.
            </p>
            <p class="text-muted-foreground text-sm mb-4">
              Recipes run inside a <a
                href="https://github.com/gmkurtzer/ginux"
                target="_blank"
                rel="noopener noreferrer"
                class="ui-link">Ginux</a
              > domain: a userspace kernel that gives each build only the inputs,
              network hosts and resources it was granted. On A/B systems, recipe
              changes compose the inactive slot, never the system you are running.
            </p>
            <CheckList items={recipeAdvantages} />
            <Fragment slot="demo">
              <CodeBlock code={recipeCode} language="rust" />
              <p class="text-sm text-muted-foreground mt-3 text-center">
                Everything a package does, in one readable file.
              </p>
            </Fragment>
          </SplitSection>
        </div>
      </section>

      <!-- Atomic Updates -->
      <section id="updates" class="py-16 section-surface">
        <div class="container max-w-4xl">
          <SplitSection reverse={true}>
            <Fragment slot="demo">
              <CodeBlock code={updateCode} language="bash" />
            </Fragment>
            <SectionHeader title="Updates You Can Undo" />
            <p class="text-muted-foreground text-sm mb-3">
              The disk holds two system slots and one running system. An update
              never changes the slot you are booted from.
            </p>
            <p class="text-muted-foreground text-sm mb-4">
              <code class="bg-muted px-1.5 py-0.5">recab</code> writes the new
              system into the other slot, carries your hostname, users and
              enabled services across, and boots it once. Mutable mode exists,
              but it is an explicit, unsafe opt-in.
            </p>
            <CheckList items={updateSteps} />
          </SplitSection>
        </div>
      </section>

      <!-- Documentation -->
      <section id="docs" class="py-16">
        <div class="container max-w-3xl text-center">
          <SectionHeader title="Embedded Documentation" centered={true} />
          <p class="text-muted-foreground text-sm max-w-2xl mx-auto mb-6">
            LevitateOS installs the Arch way, one step at a time, with a guide
            beside you. The live ISO boots into an install screen: a guided app
            for each step, and a shell one key away for anyone who would rather
            type the commands.
          </p>
          <HighlightBox class="text-left">
            <p class="text-foreground text-sm mb-3">
              The install guide sits <strong>right next to your shell</strong
              >:
            </p>
            <ul class="space-y-2 text-muted-foreground text-sm">
              {
                docsFeatures.map((feature) => (
                  <li class="flex items-start gap-2">
                    <svg
                      class="size-4 shrink-0 mt-0.5 text-[color:var(--accent)]"
                      viewBox="0 0 256 256"
                      fill="currentColor"
                    >
                      <path d="M229.66 77.66l-128 128a8 8 0 0 1-11.32 0l-56-56a8 8 0 0 1 11.32-11.32L96 188.69l122.34-122.35a8 8 0 0 1 11.32 11.32Z" />
                    </svg>
                    <span set:html={feature} />
                  </li>
                ))
              }
            </ul>
          </HighlightBox>
        </div>
      </section>

      <!-- Get Started -->
      <section id="verdict" class="py-16 section-surface">
        <div class="container max-w-3xl text-center">
          <h2 class="text-2xl sm:text-3xl font-medium mb-4">Ready to Build?</h2>
          <p class="text-sm text-muted-foreground mb-3">
            LevitateOS is for engineers who want to understand their system —
            and have the tools to shape it.
          </p>
          <p class="text-lg text-foreground font-medium mb-6">
            A clean base. Readable recipes. Rollback in one reboot.<br />
            <span class="text-primary">Your system, your way.</span>
          </p>
          <CTAButtons
            primaryHref="/download/"
            primaryText="Download"
            secondaryHref="https://github.com/LevitateOS/LevitateOS"
            secondaryText="View on GitHub"
            centered={true}
          />
        </div>
      </section>

      <!-- Standing on Giants -->
      <section id="thanks" class="py-16">
        <div class="container max-w-4xl">
          <div class="text-center mb-6">
            <h2 class="text-xl font-medium">
              Standing on the Shoulders of Giants
            </h2>
          </div>
          <div class="grid gap-4 sm:grid-cols-3 text-left">
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://archlinux.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Arch Linux</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For the blueprint on user-controlled distributions and manual
                installation.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://fedoraproject.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Fedora</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For the signed, maintained packages our core system is
                extracted from.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://alpinelinux.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Alpine Linux</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For proving that musl and simplicity can power production
                systems.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://nixos.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link">Nix</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For pioneering dependency management and reproducible builds.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://gentoo.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Gentoo</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For USE flags and the philosophy of compile-time customization.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://universal-blue.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Universal Blue</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For demonstrating image-based atomicity on the desktop.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://claude.ai/claude-code"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link"
                >Claude Code</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For AI-assisted development that accelerated this project.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://github.com/gmkurtzer/ginux"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link">Ginux</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For the userspace kernel every recipe builds inside.
              </p>
            </div>
            <div class="ui-panel ui-lift h-full p-4 flex flex-col">
              <a
                href="https://rust-lang.org"
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium ui-link">Rust</a
              >
              <p class="text-sm text-muted-foreground mt-1">
                For a compiler that catches memory bugs before they happen.
              </p>
            </div>
          </div>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
