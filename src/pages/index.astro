---
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"
import CodeBlock from "../components/CodeBlock.astro"
import ProductEntry from "../components/ProductEntry.astro"
import ImageFrame from "../components/ImageFrame.astro"
import { variants } from "../lib/variants"

// The runnable example from tools/recipe/WRITING_RECIPES.md.
const recipeCode = `const RECIPE_API = 2;
let ctx = #{
    name: "hello",
    version: "1.0",
    program: join_path(RUNTIME.paths.output, "bin/hello"),
    payload: "#!/bin/sh\\nprintf 'hello\\\\n'\\n",
};

fn is_acquired(ctx) { ready(ctx) }
fn acquire(ctx) { ctx }
fn is_built(ctx) { ready(ctx) }
fn build(ctx) { ctx }

fn is_installed(ctx) {
    if !is_file(ctx.program) { return needs_work(ctx, "hello output is missing"); }
    if read_file(ctx.program) != ctx.payload {
        return needs_work(ctx, "hello output has different contents");
    }
    ctx.outputs.program = ctx.program;
    ready(ctx)
}

fn install(ctx) {
    mkdir(dirname(ctx.program));
    write_file(ctx.program, ctx.payload);
    chmod(ctx.program, 0o755);
    ctx.outputs.program = ctx.program;
    ctx
}

fn remove(ctx) {
    if is_file(ctx.program) { rm(ctx.program); }
    ctx.outputs = #{};
    ctx
}`

// The update example from tools/recab/README.md, one step per comment.
const updateCode = `# Write the next system into the inactive slot
recab stage --rootfs /mnt/live/filesystem.erofs \\
    --kernel /mnt/boot/vmlinuz \\
    --initrd /mnt/boot/initramfs.img

# Boot the staged slot once, as a trial
recab set-next B
reboot

# Healthy: B is committed. Not healthy: you are back on A.
# Later, if you want the old system back while A still holds it:
recab rollback`

// The install commands from the repository README, one step per comment.
const installCode = `# Partition: A/B layout by default, mounted at /mnt
# (add --mode mutable for a single root)
recpart apply --disk /dev/nvme0n1 --confirm DESTROY

# Extract the system and record its mounts
recstrap /mnt
recfstab /mnt >> /mnt/etc/fstab

# See the target configuration, then apply machine settings
recsetup inspect --root /mnt --json
recsetup apply --root /mnt --hostname myhostname

# Set the installed system's root password
recchroot /mnt -- passwd`

const recipePoints = [
	"Pin exact versions: downloads need a SHA-256, git checkouts a full commit.",
	"Each check inspects the real files, so an interrupted build resumes where it stopped.",
	"Add patches directly in the recipe that builds the package.",
	"Builds run in an isolated Ginux domain, never on the running system.",
]

const updatePoints = [
	"The next system is written to the inactive slot.",
	"It boots once as a trial and is kept only if that boot is healthy.",
	"A failed trial returns you to the slot you came from.",
	"recab rollback switches back later, while the old slot still holds its system.",
]

const acknowledgments = [
	{ name: "Arch Linux", href: "https://archlinux.org", text: "For the blueprint of a user-controlled distribution and a manual installation." },
	{ name: "Fedora", href: "https://fedoraproject.org", text: "For the signed, maintained packages the LevitateOS core system is extracted from." },
	{ name: "Alpine Linux", href: "https://alpinelinux.org", text: "For the musl and busybox base that AcornOS builds on." },
	{ name: "Nix", href: "https://nixos.org", text: "For pioneering declarative dependency management and reproducible builds." },
	{ name: "Gentoo", href: "https://gentoo.org", text: "For USE flags and the philosophy of compile-time customization." },
	{ name: "Universal Blue", href: "https://universal-blue.org", text: "For demonstrating image-based updates on the desktop." },
	{ name: "Ginux", href: "https://github.com/gmkurtzer/ginux", text: "For the userspace kernel every recipe builds inside." },
	{ name: "Claude Code", href: "https://claude.ai/claude-code", text: "For AI-assisted development that accelerated this project." },
	{ name: "Rust", href: "https://rust-lang.org", text: "For the language the rec* tools and recipe are written in." },
]
const principles = [
	{ href: "#recipe", title: "Read the recipe.", text: "Every package is a Rhai file with its version, its checksum and the steps that build it. Open it before you install it." },
	{ href: "#updates", title: "Try the update.", text: "The next system boots once, as a trial, in the other slot. Keep it if it comes up healthy; fall back if it does not." },
	{ href: "#install", title: "Install with the guide open.", text: "The live ISO puts the installation guide beside your shell, so each step is one you chose and can explain." },
]
---

<BaseLayout
	title="LevitateOS: know what you run"
	description="A Linux distribution built around readable package recipes and explicit control: recipes built in isolated Ginux domains and atomic A/B updates by default."
>
	<Header />
	<main id="main" class="home">
		<section aria-labelledby="hero-title">
			<ImageFrame class="frame-host--hero">
					<span class="frame-leaf">
						<img class="logo-light" src="/brand/levitate-ink.svg" width="56" height="56" alt="" />
						<img class="logo-dark" src="/brand/levitate-paper.svg" width="56" height="56" alt="" />
					</span>
					<p class="eyebrow">Be your own package maintainer</p>
					<h1 class="hero-title" id="hero-title"><span>Know what</span> <span>you <em>run.</em></span></h1>
					<p class="hero-deck">A Linux distribution where every package is a recipe you can read, and every update is a trial you can undo.</p>
					<div class="actions">
						<a class="button" href="#recipe">Read a recipe</a>
						<a class="text-action" href="/docs/getting-started/">Read the docs</a>
					</div>
			</ImageFrame>
		</section>

		<div class="wrap">
			<section class="story-section" id="principles" aria-labelledby="principles-title">
				<ImageFrame art="fern" class="frame-host--inset frame-host--editorial">
					<div class="intro">
						<div>
							<p class="eyebrow">Nothing hidden</p>
							<h2 id="principles-title"><span>Read every package.</span> <span>Undo every update.</span></h2>
						</div>
						<p class="intro__deck">Most systems ask you to trust the package manager and hope the update boots. LevitateOS shows you the recipe, builds it in isolation, and keeps the previous system one reboot away.</p>
					</div>
				</ImageFrame>
				<ol class="principles">
					{principles.map((item, index) => (
						<li>
							<span class="principles__n" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
							<div>
								<h3><a href={item.href}>{item.title}</a></h3>
								<p>{item.text}</p>
							</div>
						</li>
					))}
				</ol>
			</section>

			<section class="story-section" id="recipe" aria-labelledby="recipe-title">
				<div class="split">
					<div class="split__copy">
						<p class="eyebrow">Recipes, not repositories</p>
						<h2 id="recipe-title">Every package is a file <em>you can read.</em></h2>
						<p>Instead of <code class="inline-code">apt</code> or <code class="inline-code">dnf</code>, LevitateOS uses <code class="inline-code">recipe</code>. A recipe is a Rhai script with the package's facts, checks that inspect the real files, and hooks that acquire, build and install it.</p>
						<p>Recipes run inside a <a href="https://github.com/gmkurtzer/ginux">Ginux</a> domain, a userspace kernel that gives each build only the inputs, network hosts and resources it was granted. On an A/B system, recipe changes compose the inactive slot, never the system you are running.</p>
						<ul class="notes">
							{recipePoints.map((point) => <li>{point}</li>)}
						</ul>
						<div class="actions">
							<a class="text-action" href="/docs/recipe-format/">Read the recipe format</a>
						</div>
					</div>
					<div class="split__example">
						<ImageFrame art="circuit" class="frame-host--inset frame-host--compact">
							<CodeBlock code={recipeCode} language="rhai" label="hello.rhai" source="tools/recipe/WRITING_RECIPES.md" />
						</ImageFrame>
					</div>
				</div>
			</section>

			<section class="story-section" id="updates" aria-labelledby="updates-title">
				<div class="split">
					<div class="split__copy">
						<ImageFrame art="mineral" class="frame-host--inset frame-host--aside">
							<div>
								<p class="eyebrow">Atomic updates</p>
								<h2 id="updates-title">Updates <em>you can undo.</em></h2>
								<p>The disk holds two system slots and one running system. An update never changes the slot you are booted from.</p>
							</div>
						</ImageFrame>
						<p><code class="inline-code">recab</code> writes the new system into the other slot, carries your hostname, users and enabled services across, and boots it once. Mutable mode exists, but it is an explicit opt-in without that safety net.</p>
						<ul class="notes">
							{updatePoints.map((point) => <li>{point}</li>)}
						</ul>
						<div class="actions">
							<a class="text-action" href="/docs/atomic-updates/">Read about A/B updates</a>
						</div>
					</div>
					<div class="split__example">
						<CodeBlock code={updateCode} language="bash" label="An update" source="tools/recab/README.md" />
					</div>
				</div>
			</section>

			<section class="story-section" id="install" aria-labelledby="install-title">
				<div class="split">
					<div class="split__copy">
						<p class="eyebrow">Installation</p>
						<h2 id="install-title">The guide sits <em>beside your shell.</em></h2>
						<p>LevitateOS installs the Arch way, one step at a time. The live ISO boots into an install screen: a shell on one side and the full installation guide on the other, with <kbd class="inline-code">Ctrl-]</kbd> switching between them.</p>
						<p>The same pages are on this site, so you can read ahead before you boot.</p>
						<div class="actions">
							<a class="text-action" href="/docs/installation/">Read the installation guide</a>
						</div>
					</div>
					<div class="split__example">
						<CodeBlock code={installCode} language="bash" label="Installing" source="README.md" />
					</div>
				</div>
			</section>

			<section class="story-section" id="variants" aria-labelledby="variants-title">
				<div class="section-head">
					<p class="eyebrow">Two variants, one pipeline</p>
					<h2 id="variants-title">Choose a foundation.</h2>
					<p>Both variants are built from their own declarations by the same pipeline. Both install as A/B systems by default; a mutable install is an explicit opt-in.</p>
				</div>
				<div class="entries">
					{variants.map((variant) => <ProductEntry variant={variant} />)}
				</div>
			</section>

			<section class="story-section" id="thanks" aria-labelledby="thanks-title">
				<div class="section-head">
					<p class="eyebrow">Acknowledgments</p>
					<h2 id="thanks-title">Standing on the shoulders <em>of giants.</em></h2>
				</div>
				<ul class="ack-list">
					{acknowledgments.map((item) => (
						<li>
							<a href={item.href}>{item.name}</a>
							<p>{item.text}</p>
						</li>
					))}
				</ul>
			</section>
		</div>

		<section class="ending" id="releases" aria-labelledby="releases-title">
			<div class="wrap ending__row">
				<div>
					<h2 id="releases-title">Not released yet. <em>Planned for 2027.</em></h2>
					<p>LevitateOS and AcornOS ship first for x86_64. The source is public now, and the status page tracks each variant.</p>
				</div>
				<div class="actions">
					<a class="text-action" href="/download/">Downloads &amp; status</a>
					<a class="text-action" href="https://github.com/LevitateOS/LevitateOS">View the source</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
