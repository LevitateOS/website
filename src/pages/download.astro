---
import BaseLayout from "../layouts/BaseLayout.astro"
import Header from "../components/layout/Header.astro"
import Footer from "../components/layout/Footer.astro"
import { variants } from "../lib/variants"

const statusClass = { available: "status--available", "in-development": "", planned: "status--planned" } as const
---

<BaseLayout
	title="Downloads & status · LevitateOS"
	description="Release status and system requirements for LevitateOS and AcornOS. Both are in development; first releases are planned for 2027, x86_64 first."
>
	<Header />
	<main id="main">
		<section class="section">
			<div class="wrap">
				<div class="section-head">
					<p class="eyebrow">Downloads &amp; status</p>
					<h1>Not released yet.</h1>
					<p class="lead">
						LevitateOS and AcornOS are in development. Each will ship as a live UEFI ISO that installs an A/B system by default. First releases are planned for 2027, x86_64 first.
					</p>
				</div>

				<div class="callout">
					<strong class="callout__label">Note</strong>
					<p>There is nothing to download yet. This page will list each release's version, architecture, format and checksum once a published artifact exists. Until then, the <a href="https://github.com/LevitateOS/LevitateOS">source is public</a> and the <a href="/docs/getting-started/">documentation</a> describes the system and its installation.</p>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="requirements-title">
			<div class="wrap">
				<div class="section-head">
					<h2 id="requirements-title">Requirements for both variants</h2>
				</div>
				<div class="table-scroll" role="region" tabindex="0" aria-labelledby="requirements-title">
					<table class="data-table">
						<thead>
							<tr><th scope="col">Component</th><th scope="col">Requirement</th></tr>
						</thead>
						<tbody>
							<tr><th scope="row">CPU</th><td>x86-64-v3: Intel Haswell or newer, AMD Zen or newer</td></tr>
							<tr><th scope="row">Firmware</th><td>UEFI, with Secure Boot disabled (the boot files are unsigned)</td></tr>
							<tr><th scope="row">Disk</th><td>An NVMe disk</td></tr>
							<tr><th scope="row">Architecture</th><td>x86_64 first; AArch64 after</td></tr>
						</tbody>
					</table>
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="variants-title">
			<div class="wrap">
				<h2 id="variants-title" class="sr-only">Variants</h2>
				<div class="release-list">
					{variants.map((variant) => (
						<article class="release" id={variant.id} aria-labelledby={`release-${variant.id}`}>
							<div class="release__intro">
								<h3 class="lockup" id={`release-${variant.id}`}>
									<img class="logo-light" src={variant.lockup.light} width={variant.lockup.width} height="48" alt={variant.name} />
									<img class="logo-dark" src={variant.lockup.dark} width={variant.lockup.width} height="48" alt={variant.name} />
								</h3>
								<p class:list={["status", statusClass[variant.status]]}>{variant.statusLabel} · {variant.release}</p>
								<p>{variant.description}</p>
							</div>
							<div class="release__details">
								<dl class="facts">
									<dt>Stack</dt>
									<dd>{variant.stack}</dd>
									<dt>Base</dt>
									<dd>{variant.base}</dd>
									<dt>Format</dt>
									<dd>{variant.format}</dd>
									<dt>Arch</dt>
									<dd>{variant.architectures}</dd>
									<dt>Version</dt>
									<dd>None released</dd>
								</dl>
								<div class="tradeoffs">
									<div>
										<h4>Strengths</h4>
										<ul>{variant.strengths.map((item) => <li>{item}</li>)}</ul>
									</div>
									<div>
										<h4>Trade-offs</h4>
										<ul>{variant.tradeoffs.map((item) => <li>{item}</li>)}</ul>
									</div>
								</div>
								<div class="table-scroll" role="region" tabindex="0" aria-label={`${variant.name} memory and disk`}>
									<table class="data-table">
										<thead>
											<tr><th scope="col">Resource</th><th scope="col">Minimum</th><th scope="col">Recommended</th></tr>
										</thead>
										<tbody>
											<tr><th scope="row">RAM</th><td>{variant.ram.minimum}</td><td>{variant.ram.recommended}</td></tr>
											<tr><th scope="row">Disk</th><td>{variant.disk.minimum}</td><td>{variant.disk.recommended}</td></tr>
										</tbody>
									</table>
								</div>
								<p><a class="text-action" href="/docs/variants/">Compare the variants in the docs</a></p>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section" aria-labelledby="install-title">
			<div class="wrap split">
				<div class="split__copy">
					<h2 id="install-title">Before installing</h2>
					<p>Installing overwrites the target disk. Back up anything you need first. LevitateOS collects no telemetry.</p>
					<p>Each ISO boots into the install screen: a shell beside the full installation guide. <kbd class="inline-code">Ctrl-]</kbd> switches pane, <kbd class="inline-code">j</kbd>/<kbd class="inline-code">k</kbd> scroll the guide, and <kbd class="inline-code">Ctrl-q</kbd> leaves the install screen.</p>
					<div class="actions">
						<a class="button button--secondary" href="/docs/installation/">Read the installation guide</a>
					</div>
				</div>
				<div class="split__example">
					<p class="eyebrow">Steps</p>
					<ol class="docs-steps">
						<li><span class="docs-steps__number" aria-hidden="true">01</span><p>Partition the disk with <code class="inline-code">recpart</code>. The A/B layout is the default.</p></li>
						<li><span class="docs-steps__number" aria-hidden="true">02</span><p>Extract the system with <code class="inline-code">recstrap</code>.</p></li>
						<li><span class="docs-steps__number" aria-hidden="true">03</span><p>Write the fstab with <code class="inline-code">recfstab</code>.</p></li>
						<li><span class="docs-steps__number" aria-hidden="true">04</span><p>Configure the system and its boot entries with <code class="inline-code">recsetup</code>.</p></li>
					</ol>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>
