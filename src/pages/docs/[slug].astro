---
import type { DocsContent } from "@levitate/docs-content"
import DocsPage from "../../components/docs/DocsPage.astro"
import { localize, pagesOf } from "../../lib/docs"

export function getStaticPaths() {
	return Object.entries(pagesOf("levitate")).map(([slug, content]) => ({
		params: { slug },
		props: { content: localize(content, "levitate"), slug },
	}))
}

interface Props {
	content: DocsContent
	slug: string
}

const { content, slug } = Astro.props
---

<DocsPage content={content} slug={slug} distro="levitate" />
