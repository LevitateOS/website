{
  "version": 3,
  "name": "Field Notes",
  "source": "Type, spacing, layout, frame and motion, plus the colours that belong to the site and not to a distro: the red action and the syntax colours of code panels. Every other colour comes from DISTROS[].look (distro/variants/<id>/distro.toml) through src/lib/look.ts. design/field-notes-v3/tokens.json is the historical identity kit.",
  "type": {
    "editorial_family": "Newsreader",
    "ui_family": "Instrument Sans",
    "code_family": "native monospace",
    "hero": {
      "size": "clamp(42px, 9.7cqi, 100px)",
      "line_height": 0.94,
      "tracking_em": -0.045
    },
    "headline": {
      "min_px": 36,
      "max_px": 54,
      "line_height": 1.02,
      "tracking_em": -0.03
    },
    "section": {
      "min_px": 31,
      "max_px": 43,
      "line_height": 1.08,
      "tracking_em": -0.025
    },
    "body": {
      "size_px": 16,
      "line_height": 1.65
    },
    "lead_px": 17,
    "action_px": 13,
    "support_px": 14,
    "label_px": 12,
    "kicker_px": 11
  },
  "shape": {
    "radius_px": 0,
    "boundary_width_px": 1,
    "control_min_px": 44
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48,
    64,
    96
  ],
  "layout": {
    "page_padding_px": 40,
    "index_px": 108,
    "index_gutter_px": 34,
    "reading_max_px": 620,
    "deck_max_px": 370,
    "hero_leaf_px": 56
  },
  "frame": {
    "asset": "/art/levitate-frame.webp",
    "width": "clamp(20px, calc(8.24cqi - 6.37px), 78px)",
    "slice": "15% 10%"
  },
  "motion": {
    "control_ms": 160,
    "easing": "ease"
  },
  "assets": {
    "lockup_header_height_px": 34,
    "lockup_compact_height_px": 28
  },
  "site_colors": {
    "action": "#B22F27",
    "action-hover": "#95271F",
    "on-action": "#F2EEE4",
    "code-keyword": "#A9CF9A",
    "code-string": "#E4CBA6",
    "code-constant": "#F0A497",
    "code-prompt": "#A9CF9A"
  }
}
