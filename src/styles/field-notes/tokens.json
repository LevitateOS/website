{
  "schema": "field-notes-tokens/1",
  "version": "1.0.0",
  "description": "Canonical values for the LevitateOS and AcornOS Field Notes identity. Project schema, not a claim of DTCG compatibility.",
  "color": {
    "paper": "#F4F0E5",
    "forest": "#183D2C",
    "vermilion": "#E64C35",
    "actionRed": "#B5412C",
    "ochre": "#B8974F"
  },
  "theme": {
    "light": {
      "page": "#F4F0E5",
      "surface": "#FAF8F0",
      "surface-subtle": "#F2EFE4",
      "heading": "#183D2C",
      "text": "#24382D",
      "muted": "#536359",
      "rule": "#C8CCBD",
      "control-border": "#7C887E",
      "action": "#B5412C",
      "action-hover": "#933623",
      "action-active": "#7B2C1D",
      "on-action": "#F4F0E5",
      "focus": "#B5412C",
      "selection": "#D6E1D2",
      "on-selection": "#183D2C",
      "success": "#2F6649",
      "warning": "#7B5A16",
      "error": "#A52F2D",
      "info": "#245A70",
      "code-bg": "#183D2C",
      "code-text": "#F4F0E5",
      "code-comment": "#BCC8BE",
      "code-keyword": "#EF8F7F",
      "code-string": "#E7CD87",
      "illustration": "#183D2C"
    },
    "dark": {
      "page": "#152E24",
      "surface": "#1D3A2D",
      "surface-subtle": "#234134",
      "heading": "#F4F0E5",
      "text": "#F4F0E5",
      "muted": "#BCC8BE",
      "rule": "#3F5A4B",
      "control-border": "#818D83",
      "action": "#EF8F7F",
      "action-hover": "#F6AD9F",
      "action-active": "#FFD0C6",
      "on-action": "#152E24",
      "focus": "#EF8F7F",
      "selection": "#476351",
      "on-selection": "#F4F0E5",
      "success": "#A8D2AF",
      "warning": "#F0C66B",
      "error": "#FFB0A0",
      "info": "#A7CCDA",
      "code-bg": "#10251B",
      "code-text": "#F4F0E5",
      "code-comment": "#BCC8BE",
      "code-keyword": "#EF8F7F",
      "code-string": "#E7CD87",
      "illustration": "#F4F0E5"
    }
  },
  "font": {
    "display": "\"FN Serif Display\", Georgia, serif",
    "italic": "\"FN Serif Italic\", Georgia, serif",
    "body": "\"FN Sans\", Arial, sans-serif",
    "mono": "\"FN Mono\", ui-monospace, monospace"
  },
  "type": {
    "hero": {
      "size": "clamp(2.75rem, 1.4rem + 5vw, 5.5rem)",
      "lineHeight": "1.02",
      "tracking": "-0.035em",
      "weight": 600,
      "family": "display"
    },
    "h1": {
      "size": "clamp(2.5rem, 1.6rem + 3vw, 4rem)",
      "lineHeight": "1.08",
      "tracking": "-0.025em",
      "weight": 600,
      "family": "display"
    },
    "h2": {
      "size": "clamp(2rem, 1.5rem + 2vw, 3rem)",
      "lineHeight": "1.12",
      "tracking": "-0.02em",
      "weight": 600,
      "family": "display"
    },
    "h3": {
      "size": "clamp(1.5rem, 1.35rem + 0.5vw, 1.75rem)",
      "lineHeight": "1.2",
      "tracking": "-0.01em",
      "weight": 600,
      "family": "display"
    },
    "lead": {
      "size": "clamp(1.25rem, 1.1rem + 0.5vw, 1.375rem)",
      "lineHeight": "1.5",
      "tracking": "0",
      "weight": 400,
      "family": "body"
    },
    "body": {
      "size": "1.125rem",
      "lineHeight": "1.65",
      "tracking": "0",
      "weight": 400,
      "family": "body"
    },
    "ui": {
      "size": "1rem",
      "lineHeight": "1.4",
      "tracking": "0",
      "weight": 600,
      "family": "body"
    },
    "caption": {
      "size": "0.8125rem",
      "lineHeight": "1.5",
      "tracking": "0",
      "weight": 400,
      "family": "body"
    },
    "eyebrow": {
      "size": "0.8125rem",
      "lineHeight": "1.4",
      "tracking": "0.08em",
      "weight": 400,
      "family": "mono"
    },
    "code": {
      "size": "0.875rem",
      "lineHeight": "1.65",
      "tracking": "0",
      "weight": 400,
      "family": "mono"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "6": "1.5rem",
    "8": "2rem",
    "12": "3rem",
    "16": "4rem",
    "24": "6rem",
    "32": "8rem"
  },
  "radius": {
    "none": "0",
    "control": "0.25rem",
    "overlay": "0.5rem"
  },
  "layout": {
    "max": "75rem",
    "prose": "68ch",
    "gutter": "clamp(1.25rem, 4vw, 3rem)",
    "gap": "2rem",
    "section": "clamp(4rem, 8vw, 7rem)"
  },
  "breakpointPx": {
    "compact": 640,
    "desktop": 960,
    "wide": 1280
  },
  "motion": {
    "fast": "120ms",
    "normal": "180ms",
    "panel": "220ms",
    "ease": "cubic-bezier(0.2, 0, 0, 1)"
  },
  "control": {
    "height": "3rem",
    "compactHeight": "2.75rem",
    "focusWidth": "2px",
    "focusOffset": "3px"
  },
  "shadow": {
    "overlay": "0 12px 32px rgb(0 0 0 / 0.16)"
  }
}
