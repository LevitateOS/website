---
import "../styles/global.css"
import { DEFAULT_DISTRO, distroName, type DistroId } from "../lib/flavor"
import { defaultAppearance, lookCss, surfaceOf } from "../lib/look"

interface Props {
	title?: string
	description?: string
	/** The flavour of the page; AcornOS pages sit under /acorn. */
	distro?: DistroId
	/** The canonical URL's path when it is not this page's own, e.g. the LevitateOS twin of a shared page. */
	canonicalPath?: string
	/** Preload the display serif when the page opens with a large serif heading. */
	preloadDisplay?: boolean
}

const {
	distro = DEFAULT_DISTRO,
	canonicalPath,
	title = `${distroName(distro)}: know what you run`,
	description = "A Linux distribution built around readable package recipes and explicit control, with atomic A/B updates by default.",
	preloadDisplay = true,
} = Astro.props

const siteBase = Astro.site || new URL("https://levitateos.org")
const canonicalURL = new URL(canonicalPath ?? Astro.url.pathname, siteBase)
const osName = distroName(distro)
const appearance = defaultAppearance(distro)
const surfaces = { light: surfaceOf(distro, "light"), dark: surfaceOf(distro, "dark") }
const acornFlavour = distro === "acorn"
const suffix = acornFlavour ? "-acorn" : ""
const ogImageURL = new URL(`/og-image${suffix}.png`, siteBase)
const ogImageAlt = acornFlavour
	? "The AcornOS wordmark and the line: The fewest parts that do the job, inside a carved wooden frame."
	: "The LevitateOS wordmark and the line: Know what you run, inside a carved green frame."
---

<!doctype html>
<html lang="en" data-theme={appearance} data-product={distro}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<!-- A stored appearance choice wins over the flavour's default; apply it before the first paint. -->
		<script is:inline define:vars={{ surfaces }}>
			;(function () {
				var root = document.documentElement
				root.classList.add("js")
				var stored = null
				try {
					stored = localStorage.getItem("appearance")
				} catch (e) {}
				if (stored !== "light" && stored !== "dark" && stored !== "system") return
				root.dataset.theme = stored
				var dark = stored === "dark" || (stored === "system" && matchMedia("(prefers-color-scheme: dark)").matches)
				var meta = document.querySelector('meta[name="theme-color"]')
				if (meta) meta.setAttribute("content", dark ? surfaces.dark : surfaces.light)
			})()
		</script>
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content={surfaces[appearance]} data-light={surfaces.light} data-dark={surfaces.dark} />
		<style is:inline set:html={lookCss(distro)} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<link rel="preload" href="/fonts/field-notes/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
		{preloadDisplay && (
			<link rel="preload" href="/fonts/field-notes/newsreader-normal.woff2" as="font" type="font/woff2" crossorigin />
		)}

		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={osName} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<link rel="icon" href={`/favicon${suffix}.ico`} sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/svg+xml" href={`/favicon${suffix}.svg`} />
		<link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon${suffix}.png`} />
		<link rel="manifest" href="/manifest.json" />

		<script is:inline type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": osName,
			"applicationCategory": "OperatingSystem",
			"operatingSystem": "Linux",
			"description": "A Linux distribution built around readable package recipes and explicit control, with atomic A/B updates by default.",
			"license": "https://opensource.org/licenses/MIT",
			"url": "https://levitateos.org",
			"author": { "@type": "Organization", "name": "LevitateOS" },
		})} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
	</body>
</html>
