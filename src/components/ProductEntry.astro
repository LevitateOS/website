---
import type { Variant } from "../lib/variants"

interface Props {
	variant: Variant
}

const { variant } = Astro.props
const statusClass = variant.status === "available" ? "status--available" : ""
---

<article class="entry" data-product={variant.id} aria-labelledby={`entry-${variant.id}`}>
	<h3 class="lockup" id={`entry-${variant.id}`}>
		<img class="logo-light" src={variant.lockup.light} width={variant.lockup.width} height="40" alt={variant.name} />
		<img class="logo-dark" src={variant.lockup.dark} width={variant.lockup.width} height="40" alt={variant.name} />
	</h3>
	<p class="entry__role">{variant.role}</p>
	<dl class="facts">
		<dt>Stack</dt>
		<dd>{variant.stack}</dd>
		<dt>Base</dt>
		<dd>{variant.base}</dd>
		<dt>Administrator</dt>
		<dd>{variant.admin}</dd>
		<dt>Desktop</dt>
		<dd>{variant.desktop}</dd>
		<dt>Kernel</dt>
		<dd>{variant.kernel}</dd>
		<dt>Updates</dt>
		<dd>A/B by default, trial boot, rollback</dd>
	</dl>
	<p class:list={["status", statusClass]}>{variant.statusLabel} · {variant.release}</p>
	<p><a class="text-action" href={`/download/#${variant.id}`}>{variant.name} status</a></p>
</article>
