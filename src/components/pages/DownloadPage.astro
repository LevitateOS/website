---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../layout/Header.astro"
import Footer from "../layout/Footer.astro"
import PageIndex from "../PageIndex.astro"
import ImageFrame from "../ImageFrame.astro"
import { variants as allVariants, variantOf } from "../../lib/variants"
import { DEFAULT_DISTRO, distroName, type DistroId } from "../../lib/flavor"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
const osName = distroName(distro)
// This flavour's release section first.
const variants = [variantOf(distro), ...allVariants.filter((v) => v.id !== distro)]

const sections = [
	{ id: "status", label: "Status" },
	{ id: "requirements", label: "Requirements" },
	...variants.map((variant) => ({ id: variant.id, label: variant.name })),
	{ id: "before-installing", label: "Installing" },
]
import { docLink } from "../../lib/docs"
import { HARDWARE } from "@levitate/docs-content/pages"
---

<BaseLayout
	title={`Downloads & status · ${osName}`}
	distro={distro}
	description="Release status and system requirements for LevitateOS and AcornOS. Both are in development; first releases are planned for 2027, x86_64 first."
>
	<Header distro={distro} />
	<div class="wrap atlas">
		<PageIndex items={sections} />
		<main id="main" class="atlas__main">
			<section class="story-section" id="status" aria-labelledby="status-title">
				<ImageFrame art="atlas" class="frame-host--inset frame-host--editorial">
					<div class="section-head">
						<p class="eyebrow">Downloads &amp; status</p>
						<h1 id="status-title">Not released <em>yet.</em></h1>
						<p class="lead">LevitateOS and AcornOS are in development. Each will ship as a live UEFI ISO that installs an A/B system by default. First releases are planned for 2027, x86_64 first.</p>
					</div>
				</ImageFrame>
				<div class="callout">
					<strong class="callout__label">Note</strong>
					<p>There is nothing to download yet. Until a release exists you can build the ISO from the source with <code class="inline-code">cargo xtask build live-tools &lt;distro&gt;</code>; the <a href={docLink("getting-started", distro)}>getting started guide</a> has the steps. This page will list each release's version, architecture, format and checksum once a published artifact exists. Until then, the <a href="https://github.com/LevitateOS/LevitateOS">source is public</a> and the <a href={docLink("getting-started", distro)}>documentation</a> describes the system and its installation.</p>
				</div>
			</section>

			<section class="story-section" id="requirements" aria-labelledby="requirements-title">
				<div class="section-head">
					<h2 id="requirements-title">Requirements for both variants</h2>
				</div>
				<div class="table-scroll prose" role="region" tabindex="0" aria-labelledby="requirements-title">
					<table class="data-table">
						<thead>
							<tr><th scope="col">Component</th><th scope="col">Requirement</th></tr>
						</thead>
						<tbody>
							<tr><th scope="row">CPU</th><td>{HARDWARE.cpu}: {HARDWARE.cpuNote}</td></tr>
							<tr><th scope="row">RAM</th><td>{HARDWARE.ram}</td></tr>
							<tr><th scope="row">Firmware</th><td>{HARDWARE.firmware}</td></tr>
							<tr><th scope="row">Disk</th><td>{HARDWARE.disk}, on {HARDWARE.storage}</td></tr>
							<tr><th scope="row">Architecture</th><td>x86_64 first; AArch64 after</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			{variants.map((variant) => (
				<section class="story-section release" id={variant.id} data-product={variant.id} aria-labelledby={`release-${variant.id}`}>
					<div class="release__intro">
						<h2 class="lockup" id={`release-${variant.id}`}>
							<img class="logo-light" src={variant.lockup.light} width={variant.lockup.width} height="40" alt={variant.name} />
							<img class="logo-dark" src={variant.lockup.dark} width={variant.lockup.width} height="40" alt={variant.name} />
						</h2>
						<p class:list={["status", { "status--available": variant.status === "available" }]}>{variant.statusLabel} · {variant.release}</p>
						<p>{variant.description}</p>
					</div>
					<div class="release__details">
						<dl class="facts">
							<dt>Stack</dt>
							<dd>{variant.stack}</dd>
							<dt>Base</dt>
							<dd>{variant.base}</dd>
							<dt>Administrator</dt>
							<dd>{variant.admin}</dd>
							<dt>Desktop</dt>
							<dd>{variant.desktop}</dd>
							<dt>Kernel</dt>
							<dd>{variant.kernel}</dd>
							<dt>Format</dt>
							<dd>{variant.format}</dd>
							<dt>Architecture</dt>
							<dd>{variant.architectures}</dd>
							<dt>Version</dt>
							<dd>None released</dd>
						</dl>
						<div class="tradeoffs">
							<div>
								<h3>Strengths</h3>
								<ul>{variant.strengths.map((item) => <li>{item}</li>)}</ul>
							</div>
							<div>
								<h3>Trade-offs</h3>
								<ul>{variant.tradeoffs.map((item) => <li>{item}</li>)}</ul>
							</div>
						</div>
						<div class="table-scroll" role="region" tabindex="0" aria-label={`${variant.name} memory and disk`}>
							<table class="data-table">
								<thead>
									<tr><th scope="col">Resource</th><th scope="col">Needs</th></tr>
								</thead>
								<tbody>
									<tr><th scope="row">RAM</th><td>{variant.ram}</td></tr>
									<tr><th scope="row">Disk</th><td>{variant.disk}</td></tr>
								</tbody>
							</table>
						</div>
						<p><a class="text-action" href={docLink("variants", distro)}>Compare the variants</a></p>
					</div>
				</section>
			))}

			<section class="story-section" id="before-installing" aria-labelledby="install-title">
				<div class="split">
					<div class="split__copy">
						<h2 id="install-title">Before installing</h2>
						<p>Installing overwrites the target disk. Back up anything you need first. LevitateOS collects no telemetry.</p>
						<p>Each ISO boots into the install screen: a shell beside the full installation guide. <kbd class="inline-code">Ctrl-]</kbd> switches pane, <kbd class="inline-code">j</kbd>/<kbd class="inline-code">k</kbd> scroll the guide, and <kbd class="inline-code">Ctrl-q</kbd> leaves the install screen.</p>
						<div class="actions">
							<a class="text-action" href={docLink("installation", distro)}>Read the {osName} installation guide</a>
						</div>
					</div>
					<div class="split__example">
						<p class="eyebrow">Steps</p>
						<ol class="docs-steps">
							<li><span class="docs-steps__number" aria-hidden="true">01</span><p>Partition the disk with <code class="inline-code">recpart</code>. The A/B layout is the default.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">02</span><p>Extract the system with <code class="inline-code">recstrap</code>.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">03</span><p>Write the fstab with <code class="inline-code">recfstab</code>.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">04</span><p>Configure the system and its boot entries with <code class="inline-code">recsetup</code>.</p></li>
						</ol>
					</div>
				</div>
			</section>
		</main>
	</div>
	<Footer distro={distro} />
</BaseLayout>
