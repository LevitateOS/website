---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../layout/Header.astro"
import Footer from "../layout/Footer.astro"
import PageIndex from "../PageIndex.astro"
import ImageFrame from "../ImageFrame.astro"
import Screenshot from "../Screenshot.astro"
import { HARDWARE } from "@levitate/docs-content/pages"
import { docLink } from "../../lib/docs"
import { variants as allVariants, variantOf } from "../../lib/variants"
import CodeBlock from "../CodeBlock.astro"
import { DEFAULT_DISTRO, distroName, type DistroId } from "../../lib/flavor"
import { formatSize, inline, isoFileName, notesFor, notesPath, osKey, RELEASE_LABEL, releaseOf, released, verifyCommand } from "../../lib/releases"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
const osName = distroName(distro)
// This flavour's release section first.
const variants = [variantOf(distro), ...allVariants.filter((v) => v.id !== distro)]

const anyReleased = released().length > 0

const sections = [
	{ id: "status", label: "Status" },
	{ id: "requirements", label: "Requirements" },
	...variants.map((variant) => ({ id: variant.id, label: variant.name })),
	{ id: "before-installing", label: "Installing" },
]
---

<BaseLayout
	title={`Downloads & status · ${osName}`}
	distro={distro}
	description={anyReleased
		? "Download the LevitateOS and AcornOS preview ISOs, with checksums, system requirements and known limits. x86_64, UEFI, tested in virtual machines."
		: "Release status and system requirements for LevitateOS and AcornOS. Neither is released yet; both ship first for x86_64."}
>
	<Header distro={distro} />
	<div class="wrap atlas">
		<PageIndex items={sections} />
		<main id="main" class="atlas__main">
			<section class="story-section" id="status" aria-labelledby="status-title">
				<ImageFrame art="atlas" class="frame-host--inset frame-host--editorial">
					<div class="section-head">
						<p class="eyebrow">Downloads &amp; status</p>
						{anyReleased ? (
							<>
							<h1 id="status-title">Preview <em>releases.</em></h1>
							<p class="lead">LevitateOS and AcornOS are independent operating systems. Their userlands are built from Fedora 45 RPM packages and Alpine 3.24 APK packages. The first releases are previews: UEFI ISOs for x86_64, tested in virtual machines only.</p>
							</>
						) : (
							<>
							<h1 id="status-title">Not released <em>yet.</em></h1>
							<p class="lead">LevitateOS and AcornOS are in development. Each will ship as a live UEFI ISO that installs an A/B system by default, x86_64 first.</p>
							</>
						)}
					</div>
				</ImageFrame>
				{anyReleased ? (
					<div class="callout">
						<strong class="callout__label">Preview</strong>
						<p>Installing overwrites the target disk, so back up anything you need first. A preview needs UEFI with Secure Boot off, has no disk encryption and has not run on real hardware yet. Each release's notes list its known limits.</p>
					</div>
				) : (
					<div class="callout">
						<strong class="callout__label">Note</strong>
						<p>There is nothing to download yet. This page will list each release's version, date, checksum and size once it is published. Until then you can build the ISO from the <a href="https://github.com/LevitateOS/LevitateOS">public source</a> with <code class="inline-code">cargo xtask build release &lt;distro&gt;</code>; the <a href={docLink("getting-started", distro)}>getting started guide</a> has the steps.</p>
					</div>
				)}
			</section>

			<section class="story-section" id="requirements" aria-labelledby="requirements-title">
				<div class="section-head">
					<h2 id="requirements-title">Requirements for both variants</h2>
				</div>
				<div class="table-scroll prose" role="region" tabindex="0" aria-labelledby="requirements-title">
					<table class="data-table">
						<thead>
							<tr><th scope="col">Component</th><th scope="col">Requirement</th></tr>
						</thead>
						<tbody>
							<tr><th scope="row">CPU</th><td>{HARDWARE.cpu}: {HARDWARE.cpuNote}</td></tr>
							<tr><th scope="row">RAM</th><td>{HARDWARE.ram}</td></tr>
							<tr><th scope="row">Firmware</th><td>{HARDWARE.firmware}</td></tr>
							<tr><th scope="row">Disk</th><td>{HARDWARE.disk}, on {HARDWARE.storage}</td></tr>
							<tr><th scope="row">Architecture</th><td>x86_64</td></tr>
						</tbody>
					</table>
				</div>
			</section>

			{variants.map((variant) => {
				const release = releaseOf(variant.id)
				const notes = release ? notesFor(osKey(variant.id), release.version) : undefined
				return (
				<section class="story-section release" id={variant.id} data-product={variant.id} aria-labelledby={`release-${variant.id}`}>
					<div class="release__intro">
						<h2 class="lockup" id={`release-${variant.id}`}>
							<img class="logo-light" src={variant.lockup.light} width={variant.lockup.width} height="40" alt={variant.name} />
							<img class="logo-dark" src={variant.lockup.dark} width={variant.lockup.width} height="40" alt={variant.name} />
						</h2>
						<p class:list={["status", { "status--available": variant.status === "available" }]}>{variant.statusLabel} · {variant.release}</p>
						<p>{variant.description}</p>
						<Screenshot id="desktop" distro={variant.id} />
					</div>
					<div class="release__details">
						<dl class="facts">
							<dt>Stack</dt>
							<dd>{variant.stack}</dd>
							<dt>Built from</dt>
							<dd>{variant.base}</dd>
							<dt>Administrator</dt>
							<dd>{variant.admin}</dd>
							<dt>Desktop</dt>
							<dd>{variant.desktop}</dd>
							<dt>Kernel</dt>
							<dd>{variant.kernel}</dd>
							<dt>Format</dt>
							<dd>{variant.format}</dd>
							<dt>Architecture</dt>
							<dd>{variant.architectures}</dd>
							<dt>Version</dt>
							<dd>{release ? `${release.version} (${RELEASE_LABEL}), ${release.date}` : "Not released yet"}</dd>
						</dl>
						{release && (
							<div class="release__download">
								<h3>Download {variant.name} {release.version} ({RELEASE_LABEL})</h3>
								<dl class="facts">
									<dt>ISO</dt>
									<dd><a class="text-action" href={release.iso.url}>{isoFileName(release)}</a></dd>
									<dt>Size</dt>
									<dd>{formatSize(release.iso.size)}</dd>
									<dt>SHA-512</dt>
									<dd class="release__hash"><code>{release.iso.sha512}</code></dd>
									<dt>Date</dt>
									<dd>{release.date}</dd>
									{release.parts.length > 0 && (
										<>
											<dt>Downloaded during install</dt>
											<dd>{formatSize(release.parts.reduce((total, part) => total + part.size, 0))} of default software, in {release.parts.length} signed parts</dd>
										</>
									)}
								</dl>
								<p>Check the download in the folder that holds it:</p>
								<CodeBlock language="bash" code={verifyCommand(release)} label="Check the ISO" />
								<p>It prints <code class="inline-code">{isoFileName(release)}: OK</code> when the file is the one we published.</p>
								{notes && (
									<>
										<h3>Known limits</h3>
										<ul class="docs-list">{notes.limits.map((item) => <li>{inline(item).map((piece) => piece.code ? <code class="inline-code">{piece.text}</code> : piece.text)}</li>)}</ul>
									</>
								)}
								<p><a class="text-action" href={notesPath(osKey(variant.id), release.version)}>Release notes for {release.version}</a></p>
							</div>
						)}
						<div class="tradeoffs">
							<div>
								<h3>Strengths</h3>
								<ul>{variant.strengths.map((item) => <li>{item}</li>)}</ul>
							</div>
							<div>
								<h3>Trade-offs</h3>
								<ul>{variant.tradeoffs.map((item) => <li>{item}</li>)}</ul>
							</div>
						</div>
						<p><a class="text-action" href={docLink("variants", distro)}>Compare the variants</a></p>
					</div>
				</section>
				)
			})}

			<section class="story-section" id="before-installing" aria-labelledby="install-title">
				<div class="split">
					<div class="split__copy">
						<h2 id="install-title">Before installing</h2>
						<p>Installing overwrites the target disk. Back up anything you need first. Neither system collects telemetry.</p>
						<p>Each ISO boots into the install screen: a shell beside the full installation guide. <kbd class="inline-code">Ctrl-]</kbd> switches pane, <kbd class="inline-code">j</kbd>/<kbd class="inline-code">k</kbd> scroll the guide, and <kbd class="inline-code">Ctrl-q</kbd> leaves the install screen.</p>
						<div class="actions">
							<a class="text-action" href={docLink("installation", distro)}>Read the {osName} installation guide</a>
						</div>
					</div>
					<div class="split__example">
						<p class="eyebrow">Steps</p>
						<ol class="docs-steps">
							<li><span class="docs-steps__number" aria-hidden="true">01</span><p>Partition the disk with <code class="inline-code">recpart</code>. The A/B layout is the default.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">02</span><p>Extract the system with <code class="inline-code">recstrap</code>.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">03</span><p>Write the fstab with <code class="inline-code">recfstab</code>.</p></li>
							<li><span class="docs-steps__number" aria-hidden="true">04</span><p>Configure the system and its boot entries with <code class="inline-code">recsetup</code>.</p></li>
						</ol>
					</div>
				</div>
			</section>
		</main>
	</div>
	<Footer distro={distro} />
</BaseLayout>
