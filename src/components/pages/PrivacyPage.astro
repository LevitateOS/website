---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../layout/Header.astro"
import Footer from "../layout/Footer.astro"
import { DEFAULT_DISTRO, type DistroId } from "../../lib/flavor"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
---

<BaseLayout distro={distro} canonicalPath="/privacy/" title="Privacy · LevitateOS" description="LevitateOS privacy policy. No tracking, no cookies, no data collection." preloadDisplay={false}>
	<Header distro={distro} />
	<main id="main" class="wrap">
		<div class="story-section prose">
			<p class="eyebrow">Last updated November 2026</p>
			<h1>Privacy</h1>

			<h2>Summary</h2>
			<p>LevitateOS respects your privacy. This website does not collect any personal data.</p>

			<h2>What we don't collect</h2>
			<ul class="docs-list">
				<li>No cookies</li>
				<li>No analytics or tracking scripts</li>
				<li>No personal information</li>
				<li>No usage data</li>
			</ul>
			<p>If you pick Light, Dark or System in the footer, that choice is kept in your own browser's storage and never leaves it; without a choice each flavour opens in its own default. Fonts are served from this site, not from a third-party font service.</p>

			<h2>The operating system</h2>
			<p>LevitateOS itself contains no telemetry. The <code class="inline-code">recipe</code> package manager and the system tools run locally. No data is sent to our servers because we don't have any servers to send data to.</p>

			<h2>Third-party services</h2>
			<p>This website is hosted on Cloudflare Pages. Cloudflare may collect standard server logs (IP addresses, request times) as part of their infrastructure. See <a href="https://www.cloudflare.com/privacypolicy/">Cloudflare's privacy policy</a> for details.</p>
			<p>Downloads may be served from GitHub Releases. See <a href="https://docs.github.com/en/site-policy/privacy-policies/github-privacy-statement">GitHub's privacy statement</a> for details.</p>

			<h2>Contact</h2>
			<p>Questions about this policy? Open an issue on <a href="https://github.com/LevitateOS/LevitateOS/issues">GitHub</a>.</p>
		</div>
	</main>
	<Footer distro={distro} />
</BaseLayout>
