---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../layout/Header.astro"
import Footer from "../layout/Footer.astro"
import CodeBlock from "../CodeBlock.astro"
import ImageFrame from "../ImageFrame.astro"
import Screenshot from "../Screenshot.astro"
import { docLink } from "../../lib/docs"
import { DEFAULT_DISTRO, distroName, href, type DistroId } from "../../lib/flavor"
import { DISTROS } from "@levitate/docs-content/distros"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
const { profile } = DISTROS.find((d) => d.id === distro)!
const osName = distroName(distro)
const admin = profile.privilege

// ripgrep as the specification shows it (tools/recipe/docs/recipe-format.md, 9.1), without ABOUT,
// the notes an app shows. Line numbers of the notes follow the code.
const recipeCode = `const RECIPE_API = 1;
const NEEDS = #{
    outputs: #{ "package": "directory" },
    network: ["github.com:443", "release-assets.githubusercontent.com:443"],
    network_max_bytes: 8388608,
    timeout_secs: 300,
};

const PACKAGE = #{
    name: "ripgrep",
    version: "15.2.0",
    description: "Fast recursive text search with rg",
};

const SOURCES = #{
    release: #{
        url: "https://github.com/BurntSushi/ripgrep/releases/download/15.2.0/ripgrep-15.2.0-x86_64-unknown-linux-musl.tar.gz",
        sha256: "33e15bcf1624b25cdd2a55813a47a2f95dbe126268203e76aa6a585d1e7b149c",
    },
};

const FILES = [
    ["rg",          "bin/rg", 0o755],
    ["doc/rg.1",    "share/man/man1/rg.1"],
    ["COPYING",     "share/licenses/ripgrep/COPYING"],
    ["LICENSE-MIT", "share/licenses/ripgrep/LICENSE-MIT"],
    ["UNLICENSE",   "share/licenses/ripgrep/UNLICENSE"],
];

const UPSTREAM = #{ github: "BurntSushi/ripgrep" };`

const recipeNotes = [
	{ line: 9, text: "PACKAGE: what it is, and which version this recipe installs." },
	{ line: 15, text: "SOURCES: where it comes from, pinned by checksum. Nothing else is downloaded." },
	{ line: 22, text: "FILES: what goes where. No function is needed to copy files." },
	{ line: 30, text: "UPSTREAM: where the newest version can be found, so Recipe can tell you about it." },
]

const steps = [
	{ title: "Download", text: "Fetches what the recipe names and checks each file against the SHA-256 the recipe pins." },
	{ title: "Build", text: "Compiles, when there is something to compile. Many recipes have nothing to compile and show no build step." },
	{ title: "Install", text: "Puts the program in place: for your own account, or for everyone on the computer." },
	{ title: "Clean up", text: "Removes the download and the build. Only the installed program stays." },
]

const diskFacts = [
	{ what: "After an install", text: "Only the installed program and its receipt remain." },
	{ what: "Keeping the rest", text: "Your choice, for people who rebuild often. It is off unless you turn it on." },
	{ what: "Removing a program", text: "Frees its space at once. No old versions are kept." },
	{ what: "Storage", text: "One page lists everything Recipe holds, each kind with its size and a way to remove it." },
]

const notDone = [
	{ lead: "It never asks an AI.", text: "When something fails, Recipe says what failed. Taking that to an agent of your own is your choice." },
	{ lead: "It never updates by itself.", text: "Nothing is checked, downloaded or replaced until you ask." },
	{ lead: "It keeps no old versions.", text: "A program is installed or it is not." },
	{ lead: "It hides nothing it stores.", text: "If Recipe holds it, the Storage page shows it." },
]

const wallOutside = ["Your home folder", "Every host the recipe did not name", "Devices and raw network packets", "Listening sockets"]
const wallInside = ["The inputs it declared, read-only", "Its own work and output folders", "The hosts and ports it listed", "Memory, storage and time, each bounded"]

const grantPoints = [
	{ lead: "Read without running", text: "What it may use is on the page before it does anything." },
	{ lead: "Enforced, not advised", text: "A recipe cannot add a host, a file or a larger limit to what it declared. You can narrow the grants when you install; nobody can widen them." },
	{ lead: "What you read is what runs", text: "Downloads must carry the SHA-256 the recipe pins." },
]

const ginuxLimits = [
	"Ginux is not a virtual machine. Its own README says the host kernel stays trusted, and that it is a narrow research project.",
	"A recipe that runs on the host is held by Recipe's own checks, not by Ginux.",
	"A grant for an address does not tell apart two sites on the same address and port.",
	"The program you install runs with your rights once it is installed. Isolation covers its install, not its use.",
	"The descriptive notes in a recipe (ABOUT) are the author's words. Only NEEDS is enforced.",
]

const scopeCode = `# for me: your own account, no administrator needed
recipe install ripgrep

# for everyone: the whole computer, as administrator
${admin} recipe --system install ripgrep`

const needsCode = `const NEEDS = #{
    inputs: #{ source: "directory" },
    outputs: #{ program: "file" },
    network: ["publisher.example:443"],
    memory_mib: 4096,
    timeout_secs: 3600,
};`

const sourceCode = `recipe source add https://github.com/OWNER/recipes    # a repository of recipes
recipe source add --path ~/my-recipes                 # a folder of your own
recipe source list
recipe install SOURCE:NAME                            # name the source when two have the same recipe`

const beforePoints = [
	"Choose software for your own account or for the whole computer.",
	"Review the network hosts, files and resources the recipe may use.",
	"Recipe runs it within those declared limits.",
]
---

<BaseLayout
	title={`Recipe · ${osName}`}
	description="Recipe is the software manager of LevitateOS and AcornOS: readable recipes, your own sources, system-wide or personal installs, and isolation for the programs a recipe starts."
	distro={distro}
	canonicalPath="/recipe/"
>
	<Header distro={distro} />
	<main id="main" class="home">
		<section aria-labelledby="hero-title">
			<ImageFrame class="frame-host--hero">
				<p class="eyebrow">Software, by recipe</p>
				<h1 class="hero-title" id="hero-title"><span>Read it,</span> <span>then <em>trust it.</em></span></h1>
				<p class="hero-deck">Recipe downloads, builds, installs and cleans up software. Every program has a recipe: a short file you can read before anything runs. LevitateOS and AcornOS use the same Recipe.</p>
				<div class="actions">
					<a class="button" href="#ginux">How Ginux isolates a recipe</a>
					<a class="text-action" href={docLink("recipe-format", distro)}>Read the recipe format</a>
				</div>
			</ImageFrame>
		</section>

		<div class="wrap">
			<section class="story-section" id="steps" aria-labelledby="steps-title">
				<div class="section-head">
					<p class="eyebrow">The four steps</p>
					<h2 id="steps-title">One button, <em>or one step at a time.</em></h2>
					<p>Install runs all four, and skips what is already done. Each step also works alone: download now, build later, clean up when you choose.</p>
				</div>
				<ol class="columns">
					{steps.map((step, index) => (
						<li class="column">
							<p class="column__label">{index + 1}</p>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="story-section" id="disk" aria-labelledby="disk-title">
				<div class="split">
					<div class="split__copy">
						<p class="eyebrow">Your disk</p>
						<h2 id="disk-title">Nothing is <em>left behind.</em></h2>
						<p>A program that needs gigabytes to build takes megabytes once it is installed. Recipe gives the rest back, and it shows you everything it holds.</p>
						<p class="status">In development. Written, not built or run yet.</p>
					</div>
					<dl class="facts">
						{diskFacts.map((item) => (
							<>
								<dt>{item.what}</dt>
								<dd>{item.text}</dd>
							</>
						))}
					</dl>
				</div>
			</section>

			<section class="story-section" id="software" aria-labelledby="software-title">
				<div class="section-head">
					<p class="eyebrow">Start with the software</p>
					<h2 id="software-title">Find what you <em>want to run.</em></h2>
					<p>Search by name or browse by kind of software. Each entry leads to the recipe behind the program, so finding it and understanding it happen in the same place.</p>
				</div>
				<Screenshot id="recipe-browse" distro={distro} showStatus={false} />
				<p class="support">Development previews; application content uses sample data.</p>
			</section>

			<section class="story-section" id="before-install" aria-labelledby="before-title">
				<div class="section-head">
					<p class="eyebrow">Before you install</p>
					<h2 id="before-title">Know what <em>will change.</em></h2>
					<p>Choosing Install brings you to the decision, before the work starts. Recipe shows where the software will go and what it may use along the way.</p>
					<ul class="notes">
						{beforePoints.map((point) => <li>{point}</li>)}
					</ul>
				</div>
				<Screenshot id="recipe-before-install" distro={distro} showStatus={false} />
			</section>

			<section class="story-section" id="scopes" aria-labelledby="scopes-title">
				<div class="section-head">
					<p class="eyebrow">For me, or for everyone</p>
					<h2 id="scopes-title">Choose <em>where it goes.</em></h2>
					<p>Software can be for your own account or for the whole computer. "For me" is the default.</p>
					<ul class="notes">
						<li><strong>For me</strong> goes into your own store, <code class="inline-code">~/.local/share/recipe</code>. Other people on the computer do not see it.</li>
						<li><strong>For everyone</strong> is system software. On an A/B installation it is written into the other root, which is unlocked. The booted root is never touched. It becomes active when that root is started.</li>
						<li>A mutable installation has one root and no recab. System software goes straight into the running system.</li>
					</ul>
				</div>
				<CodeBlock code={scopeCode} language="bash" label="Two scopes" source="tools/recipe/README.md" />
				<p>If you make the other root a copy of the booted root again, the system changes Recipe wrote there are gone. Recipe notices, and writes exactly that system part again. It does not redo the whole install, and it does not touch what you installed for yourself. Until that has succeeded, it does not report the part as done.</p>
				<p>The software that comes with the system is installed this way too. The system image holds only the minimal base. The desktop, Firefox, audio, networking, Bluetooth, printing, the firewall and fonts are group recipes, and the installer installs each system's default set from a package cache on the install medium. Each group has a Recipe receipt, so you can remove or swap it in Recipe, the desktop included. Removing the last desktop is allowed and leaves a text login.</p>
				<div class="actions">
					<a class="text-action" href={docLink("atomic-updates", distro)}>Read about A/B roots</a>
					<a class="text-action" href={`${docLink("post-installation", distro)}#software-with-recipe`}>Read the software guide</a>
				</div>
			</section>

			<section class="story-section" id="sources" aria-labelledby="sources-title">
				<div class="section-head">
					<p class="eyebrow">Where recipes come from</p>
					<h2 id="sources-title">Sources, <em>yours included.</em></h2>
					<p>A source is a collection of recipes. The system ships the official one, so its recipes install offline. You can add others: a repository on github.com or gitlab.com, or a folder on your own disk.</p>
					<ul class="notes">
						<li>A remote source publishes an index. Recipe keeps the index and downloads a recipe's files only when you install it.</li>
						<li>Every downloaded file is checked against the SHA-256 in the index. A file that differs stops the install before anything runs.</li>
						<li>A folder you point Recipe at is read as it is, edits included.</li>
					</ul>
				</div>
				<CodeBlock code={sourceCode} language="bash" label="Adding sources" source="tools/recipe/README.md" />
			</section>

			<section class="story-section" id="write" aria-labelledby="write-title">
				<div class="section-head">
					<p class="eyebrow">The recipe</p>
					<h2 id="write-title">A recipe <em>states facts.</em></h2>
					<p>What the program is, where it comes from, what goes where. Recipe does the downloading, checking, unpacking and placing. A recipe has code only for what is unusual. Put your own in a folder, add that folder as a source, and Recipe reads it like any other.</p>
				</div>
				<ImageFrame art="circuit" class="frame-host--inset frame-host--compact">
					<CodeBlock code={recipeCode} language="rhai" label="ripgrep.rhai" source="without ABOUT, the notes an app shows" notes={recipeNotes} />
				</ImageFrame>
				<div class="actions">
					<a class="text-action" href={docLink("recipe-format", distro)}>Read the recipe format</a>
					<a class="text-action" href={docLink("helpers-overview", distro)}>Rhai helpers</a>
					<a class="text-action" href={docLink("cli-reference", distro)}>CLI reference</a>
				</div>
			</section>

			<section class="story-section" id="updates" aria-labelledby="updates-title">
				<div class="section-head">
					<p class="eyebrow">Updates</p>
					<h2 id="updates-title">Updates happen <em>when you ask.</em></h2>
					<p>Recipe looks for newer versions only when you tell it to, and it updates one program at a time. It never changes a recipe.</p>
				</div>
				<div class="columns columns--pair">
					<div class="column">
						<h3>Update</h3>
						<p>The recipe you have fetched names a newer version than the one installed. One press installs that version.</p>
					</div>
					<div class="column">
						<h3>Newer upstream</h3>
						<p>The program's authors have released something the recipe does not name yet. Recipe tells you. The recipe has to be updated first, by hand or by an agent of your own.</p>
					</div>
				</div>
			</section>

			<section class="story-section" id="proprietary" aria-labelledby="proprietary-title">
				<div class="section-head">
					<p class="eyebrow">Proprietary software</p>
					<h2 id="proprietary-title">Your choice, <em>and flagged.</em></h2>
					<p>Neither system ships proprietary software in its image. It reaches a machine only because you installed it through Recipe.</p>
					<ul class="notes">
						<li>A recipe for proprietary software says so in its <code class="inline-code">license</code>, which starts with <code class="inline-code">proprietary</code>, and Recipe shows that flag.</li>
						<li>The recipe fetches the program from the vendor's own site. Where the vendor's terms require it, we do not redistribute it.</li>
						<li>Being proprietary never earns an app a place in the base image, and it never bans it from Recipe.</li>
						<li>Steam is a recipe for LevitateOS only. It is fetched from Valve, and it needs 32-bit glibc libraries that AcornOS's musl base cannot run. The recipe is written and has not been run yet.</li>
					</ul>
				</div>
			</section>

			<section class="story-section" id="fits" aria-labelledby="fits-title">
				<div class="section-head">
					<p class="eyebrow">Only where it can run</p>
					<h2 id="fits-title">An app is offered <em>where its base can run it.</em></h2>
					<p>{osName} and its sibling run the same Recipe, not the same list of apps. {osName} uses {profile.libc}. A recipe can say which C libraries its build works with. Before it downloads anything, Recipe compares that with the system's.</p>
					<ul class="notes">
						<li>If they do not match, Recipe says what the build is linked against and what this system has, and stops.</li>
						<li>You can install it anyway with <code class="inline-code">--any-libc</code>. The program may then not start.</li>
						<li>A recipe whose package carries its own C library says so, and Recipe tells you it was tried on that library and not yet on yours.</li>
					</ul>
				</div>
			</section>

			<section class="story-section" id="notdo" aria-labelledby="notdo-title">
				<div class="section-head">
					<p class="eyebrow">Plainly</p>
					<h2 id="notdo-title">What Recipe <em>does not do.</em></h2>
				</div>
				<ul class="points">
					{notDone.map((item) => (
						<li>
							<span class="points__lead">{item.lead}</span>
							<span class="points__text">{item.text}</span>
						</li>
					))}
				</ul>
			</section>

			<section class="story-section" id="ginux" aria-labelledby="ginux-title">
				<div class="ginux-parts">
					<div class="head-credit">
						<div class="section-head">
							<p class="eyebrow">Ginux</p>
							<h2 id="ginux-title">Programs a recipe starts <em>run in isolation.</em></h2>
							<p>Installing software means running someone else's build steps. Recipe puts a wall around the steps that start programs, and it lets you read, ahead of time, what is on the other side of it.</p>
						</div>
						<aside class="credit" aria-labelledby="ginux-credit-title">
							<p class="eyebrow" id="ginux-credit-title">Whose it is</p>
							<p>Ginux is Greg Kurtzer's project, <a href="https://github.com/gmkurtzer/ginux">gmkurtzer/ginux</a>. We did not make it. Recipe uses it as technology. We keep a <a href="https://github.com/LevitateOS/ginux">fork</a> and follow upstream.</p>
						</aside>
					</div>

					<div class="wall">
						<div class="wall__part">
							<p class="eyebrow">Your computer</p>
							<h3>Stays outside</h3>
							<ul class="notes">
								{wallOutside.map((item) => <li>{item}</li>)}
							</ul>
						</div>
						<div class="wall__part wall__part--ginux">
							<p class="eyebrow">The wall</p>
							<h3>Ginux</h3>
							<p>A userspace kernel that runs as an ordinary Linux process. It sits between a program and the host kernel. For each system call it answers it itself, performs a narrow checked operation, or denies it.</p>
						</div>
						<div class="wall__part">
							<p class="eyebrow">The domain</p>
							<h3>What the recipe gets</h3>
							<ul class="notes">
								{wallInside.map((item) => <li>{item}</li>)}
							</ul>
						</div>
					</div>

					<div>
						<div class="section-head">
							<h3>Which recipes run behind the wall</h3>
							<p>Recipe reads a recipe's source before anything runs and picks one of two ways. <code class="inline-code">recipe info NAME</code> tells you which, and why.</p>
						</div>
						<div class="columns columns--pair">
							<div class="column">
								<p class="column__label">When the recipe can start a program</p>
								<h4>In a Ginux domain</h4>
								<p>Recipes that run commands, check out source with git, or build with make or cmake. Each dependency runs in its own domain, under its own grants.</p>
							</div>
							<div class="column">
								<p class="column__label">When it can start none</p>
								<h4>On the host, confined by Recipe</h4>
								<p>Recipes that only download, check, unpack and copy. They reach only the run's own folders and the hosts they listed, and a filter refuses new programs.</p>
							</div>
						</div>
					</div>

					<div class="split">
						<div class="split__copy">
							<h3>The grants are data you can read</h3>
							<p>What a recipe may use is its <code class="inline-code">NEEDS</code>: literal data, with no helper calls and no variables.</p>
							<ul class="points">
								{grantPoints.map((item) => (
									<li>
										<span class="points__lead">{item.lead}</span>
										<span class="points__text">{item.text}</span>
									</li>
								))}
							</ul>
						</div>
						<div class="split__example">
							<CodeBlock code={needsCode} language="rhai" label="NEEDS" source="what this recipe may use" />
						</div>
					</div>

					<div>
						<h3>What it does not do</h3>
						<ul class="docs-list">
							{ginuxLimits.map((item) => <li>{item}</li>)}
						</ul>
						<p class="closing">The wall makes what you read true. <em>It does not make an untrusted recipe safe.</em></p>
						<div class="actions">
							<a class="text-action" href="https://github.com/gmkurtzer/ginux">Ginux upstream</a>
							<a class="text-action" href={docLink("faq", distro)}>Architecture FAQ</a>
						</div>
					</div>
				</div>
			</section>
		</div>

		<section class="ending" aria-labelledby="recipe-end-title">
			<div class="wrap ending__row">
				<h2 id="recipe-end-title">One Recipe. <em>Both systems.</em></h2>
				<div class="actions">
					<a class="text-action" href={href("/", "levitate")}>LevitateOS</a>
					<a class="text-action" href={href("/", "acorn")}>AcornOS</a>
					<a class="text-action" href={href("/download/", distro)}>Downloads &amp; status</a>
				</div>
			</div>
		</section>
	</main>
	<Footer distro={distro} />
</BaseLayout>
