---
import BaseLayout from "../../layouts/BaseLayout.astro"
import Header from "../layout/Header.astro"
import Footer from "../layout/Footer.astro"
import CodeBlock from "../CodeBlock.astro"
import ProductEntry from "../ProductEntry.astro"
import ImageFrame from "../ImageFrame.astro"
import Screenshot from "../Screenshot.astro"
import { variantOf } from "../../lib/variants"
import { docLink } from "../../lib/docs"
import { DEFAULT_DISTRO, distroName, href, otherFlavor, type DistroId } from "../../lib/flavor"
import { DISTROS } from "@levitate/docs-content/distros"
import { commands, EXAMPLE_DISK, EXAMPLE_SETUP } from "@levitate/docs-content/install"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
const variant = variantOf(distro)
const other = variantOf(otherFlavor(distro).id)
const record = DISTROS.find((d) => d.id === distro)!
const { profile } = record
const osName = distroName(distro)

// The runnable example from tools/recipe/WRITING_RECIPES.md.
const recipeCode = `const RECIPE_API = 2;
let ctx = #{
    name: "hello",
    version: "1.0",
    program: join_path(RUNTIME.paths.output, "bin/hello"),
    payload: "#!/bin/sh\\nprintf 'hello\\\\n'\\n",
};

fn is_acquired(ctx) { ready(ctx) }
fn acquire(ctx) { ctx }
fn is_built(ctx) { ready(ctx) }
fn build(ctx) { ctx }

fn is_installed(ctx) {
    if !is_file(ctx.program) { return needs_work(ctx, "hello output is missing"); }
    if read_file(ctx.program) != ctx.payload {
        return needs_work(ctx, "hello output has different contents");
    }
    ctx.outputs.program = ctx.program;
    ready(ctx)
}

fn install(ctx) {
    mkdir(dirname(ctx.program));
    write_file(ctx.program, ctx.payload);
    chmod(ctx.program, 0o755);
    ctx.outputs.program = ctx.program;
    ctx
}

fn remove(ctx) {
    if is_file(ctx.program) { rm(ctx.program); }
    ctx.outputs = #{};
    ctx
}`

/** An annotated example: groups of lines with blank lines between them; each group's note points at one of its lines. */
function annotate(groups: { lines: string[]; note: string; at?: number; gap?: number }[]) {
	const out: string[] = []
	const notes: { line: number; text: string }[] = []
	let count = 0
	groups.forEach((group, index) => {
		const text = group.lines.join("\n")
		notes.push({ line: count + 1 + (group.at ?? 0), text: group.note })
		out.push(text)
		count += text.split("\n").length
		if (index < groups.length - 1) {
			const gap = group.gap ?? 2
			out.push(...Array(gap).fill(""))
			count += gap
		}
	})
	return { code: out.join("\n"), notes }
}

// The update example: the install procedure's stage command, with the margin notes explaining it.
const update = annotate([
	{
		lines: [`# as administrator, with ${profile.privilege}`, "mount -o loop,ro <release>.iso /mnt"],
		at: 1,
		note: "The new release, mounted from its ISO.",
	},
	{ lines: [commands.stage(record)], gap: 3, note: "Written to the other slot. The running system is never touched." },
	{ lines: ["recab set-next B", "reboot"], note: "One trial boot. If B does not come up healthy, you are back on A." },
	{ lines: ["recab rollback"], note: "Changed your mind? Back to A, while A still holds it." },
])

// The install commands, from the install procedure the guide and the install screen use.
// Each group gets a margin note on its first line.
const example = EXAMPLE_DISK.target
const install = annotate([
	{ lines: [commands.partition(EXAMPLE_DISK.disk)], gap: 3, note: "Nothing is wiped until you type the word yourself." },
	{ lines: [commands.extract(example), commands.fstab(example)], note: "The whole system, laid down from the live ISO." },
	{
		lines: [
			commands.inspect(example, true),
			commands
				.configure(example, { timezone: EXAMPLE_SETUP.timezone, locale: EXAMPLE_SETUP.locale })
				.replace(/ --(timezone|locale)/g, " \\\n    --$1"),
		],
		note: "See what it will configure before it does.",
	},
	{ lines: [commands.password(example)], note: "Inside your new system, before its first boot." },
])

// Notes on hello.rhai, each beside the line it explains.
const recipeNotes = [
	{ line: 1, text: "Every recipe names the API it was written for." },
	{ line: 14, text: "Asks the files on disk, not a database. An interrupted install resumes here." },
	{ line: 23, text: "Runs inside a Ginux domain, never on the system you are using." },
	{ line: 31, text: "Removal is in the recipe too. You can read what it deletes." },
]

const recipePoints = [
	"Choose software for your own account or for the whole computer.",
	"Review the network hosts, files and resources the recipe may use.",
	"Let Recipe build it inside Ginux, within those declared limits.",
]

const updatePoints = [
	"The next system is written to the inactive slot.",
	"It boots once as a trial and is kept only if that boot is healthy.",
	"A failed trial returns you to the slot you came from.",
	"recab rollback switches back later, while the old slot still holds its system.",
]

const acknowledgments = [
	{ name: "Arch Linux", href: "https://archlinux.org", text: "For the blueprint of a user-controlled distribution and a manual installation." },
	{ name: "Fedora", href: "https://fedoraproject.org", text: "For the signed, maintained packages the LevitateOS core system is extracted from." },
	{ name: "Alpine Linux", href: "https://alpinelinux.org", text: "For the musl and busybox base that AcornOS builds on." },
	{ name: "Nix", href: "https://nixos.org", text: "For pioneering declarative dependency management and reproducible builds." },
	{ name: "Gentoo", href: "https://gentoo.org", text: "For USE flags and the philosophy of compile-time customization." },
	{ name: "Universal Blue", href: "https://universal-blue.org", text: "For demonstrating image-based updates on the desktop." },
	{ name: "Ginux", href: "https://github.com/gmkurtzer/ginux", text: "For the userspace kernel every recipe builds inside." },
	{ name: "Claude Code", href: "https://claude.com/claude-code", text: "For AI-assisted development that accelerated this project." },
	{ name: "Rust", href: "https://rust-lang.org", text: "For the language the rec* tools and recipe are written in." },
]
---

<BaseLayout title={variant.meta.title} description={variant.meta.description} distro={distro}>
	<Header distro={distro} />
	<main id="main" class="home">
		<section aria-labelledby="hero-title">
			<ImageFrame class="frame-host--hero">
					<span class="frame-leaf">
						<img class="logo-light" src={variant.mark.light} width="56" height="56" alt="" />
						<img class="logo-dark" src={variant.mark.dark} width="56" height="56" alt="" />
					</span>
					<p class="eyebrow">{variant.hero.eyebrow}</p>
					<h1 class="hero-title" id="hero-title"><span>{variant.hero.title.first}</span> <span>{variant.hero.title.second}{variant.hero.title.second && " "}<em>{variant.hero.title.emphasis}</em></span></h1>
					<p class="hero-deck">{variant.hero.deck}</p>
					<div class="actions">
						<a class="button" href="#desktop">Explore the desktop</a>
						<a class="text-action" href={docLink("getting-started", distro)}>Read the docs</a>
					</div>
			</ImageFrame>
		</section>

		<div class="wrap">
			<section class="story-section" id="desktop" aria-labelledby="desktop-title">
				<div class="section-head">
					<p class="eyebrow">On the desktop</p>
					<h2 id="desktop-title">{variant.desktopStory.title}</h2>
					<p>{variant.desktopStory.text}</p>
				</div>
				<Screenshot id="desktop-recipe" distro={distro} priority showStatus={false} />
				<p class="support">Development previews throughout this page; application content uses sample data.</p>
			</section>

			<section class="story-section" id="software" aria-labelledby="software-title">
				<ImageFrame art="fern" class="frame-host--inset frame-host--editorial">
					<div class="intro">
						<div>
							<p class="eyebrow">Start with the software</p>
							<h2 id="software-title"><span>Find what you</span> <span>want to <em>run.</em></span></h2>
						</div>
						<p class="intro__deck">Search by name or browse by kind of software. Each entry leads to the recipe behind the program, so finding it and understanding it happen in the same place.</p>
					</div>
				</ImageFrame>
				<Screenshot id="recipe-browse" distro={distro} showStatus={false} />
				<div class="actions">
					<a class="text-action" href="#recipe">See what happens before Install</a>
					<a class="text-action" href={`${docLink("post-installation", distro)}#software-with-recipe`}>Read the software guide</a>
				</div>
			</section>

			<section class="story-section" id="recipe" aria-labelledby="recipe-title">
				<div class="section-head">
					<p class="eyebrow">Before you install</p>
					<h2 id="recipe-title">Know what <em>will change.</em></h2>
					<p>Choosing Install brings you to the decision, before the work starts. Recipe shows where the software will go, how it will be built, and what it may use along the way.</p>
					<ul class="notes">
						{recipePoints.map((point) => <li>{point}</li>)}
					</ul>
				</div>
				<Screenshot id="recipe-before-install" distro={distro} showStatus={false} />
				<details class="command-example">
					<summary>Look inside the recipe file</summary>
					<p>The window reads a Rhai file. That file holds the package facts and the steps that acquire, build, install and remove it. Here is a complete small recipe you can read from beginning to end.</p>
					<ImageFrame art="circuit" class="frame-host--inset frame-host--compact">
						<CodeBlock code={recipeCode} language="rhai" label="hello.rhai" source="tools/recipe/WRITING_RECIPES.md" notes={recipeNotes} />
					</ImageFrame>
					<div class="actions"><a class="text-action" href={docLink("recipe-format", distro)}>Read the recipe format</a></div>
				</details>
			</section>

			<section class="story-section" id="updates" aria-labelledby="updates-title">
				<div class="split">
					<div class="split__copy">
						<ImageFrame art="mineral" class="frame-host--inset frame-host--aside">
							<div>
								<p class="eyebrow">When the system changes</p>
								<h2 id="updates-title">Keep using this system. <em>Try the next one.</em></h2>
								<p>Recab keeps the system you are using beside the one you are preparing. You can see which is which before you restart.</p>
							</div>
						</ImageFrame>
						<p>Software changes for the whole computer go into the next system. Recab brings system updates into that same preparation, preserving your changes or showing you what needs a decision. The running system stays as it is.</p>
						<ul class="notes">
							{updatePoints.map((point) => <li>{point}</li>)}
						</ul>
						<div class="actions">
							<a class="text-action" href={docLink("atomic-updates", distro)}>Read about A/B updates</a>
						</div>
					</div>
					<div class="split__example">
						<Screenshot id="recab-ready" distro={distro} showStatus={false} />
					</div>
				</div>
				<details class="command-example">
					<summary>See the update commands</summary>
					<CodeBlock code={update.code} language="bash" label="An update" source="docs/content/src/install.ts" notes={update.notes} />
				</details>
			</section>

			<section class="story-section" id="storage" aria-labelledby="storage-title">
				<div class="section-head">
					<p class="eyebrow">Once you have made it yours</p>
					<h2 id="storage-title">See where the <em>space goes.</em></h2>
					<p>Your files, downloaded software and build leftovers all take room. Recdirstat puts their sizes on a map, so you can see the large places and inspect what is inside before deciding what to keep.</p>
				</div>
				<Screenshot id="disk-browse" distro={distro} showStatus={false} />
				<div class="actions"><a class="text-action" href={`${docLink("post-installation", distro)}#disk-usage`}>Read the disk usage guide</a></div>
			</section>

			<section class="story-section" id="install" aria-labelledby="install-title">
				<div class="split">
					<div class="split__copy">
						<p class="eyebrow">Installation</p>
						<h2 id="install-title">Start with the guide <em>beside you.</em></h2>
						<p>To reach that desktop, boot the live ISO and install one step at a time. A shell sits beside the full installation guide; <kbd class="inline-code">Ctrl-]</kbd> switches between them.</p>
						<p>Read the same guide here before you boot. It takes you from the disk layout to your first login, with each command explained.</p>
						<div class="actions">
							<a class="text-action" href={docLink("installation", distro)}>Read the {osName} installation guide</a>
						</div>
					</div>
					<div class="split__example">
						<CodeBlock code={install.code} language="bash" label="Installing" source="docs/content/src/install.ts" notes={install.notes} />
					</div>
				</div>
			</section>

			<section class="story-section" id="variants" aria-labelledby="variants-title">
				<div class="section-head">
					<p class="eyebrow">Two variants, one pipeline</p>
					<h2 id="variants-title">The same tools. <em>Two foundations.</em></h2>
					<p>The Recipe workflow you have seen belongs to both variants, alongside Recab and Recdirstat. Choose the base and desktop that suit you; both install as A/B systems by default.</p>
				</div>
				<div class="entries">
					<ProductEntry variant={variant} distro={distro} />
					<ProductEntry variant={other} distro={distro} />
				</div>
			</section>

			<section class="story-section" id="thanks" aria-labelledby="thanks-title">
				<div class="section-head">
					<p class="eyebrow">Acknowledgments</p>
					<h2 id="thanks-title">Standing on the shoulders <em>of giants.</em></h2>
				</div>
				<ul class="ack-list">
					{acknowledgments.map((item) => (
						<li>
							<a href={item.href}>{item.name}</a>
							<p>{item.text}</p>
						</li>
					))}
				</ul>
			</section>
		</div>

		<section class="ending" id="releases" aria-labelledby="releases-title">
			<div class="wrap ending__row">
				<div>
					<h2 id="releases-title">Not released yet. <em>Planned for 2027.</em></h2>
					<p>LevitateOS and AcornOS ship first for x86_64. The source is public now, and the status page tracks each variant.</p>
				</div>
				<div class="actions">
					<a class="text-action" href={href("/download/", distro)}>Downloads &amp; status</a>
					<a class="text-action" href="https://github.com/LevitateOS/LevitateOS">View the source</a>
				</div>
			</div>
		</section>
	</main>
	<Footer distro={distro} />
</BaseLayout>

<style>
	/* A disclosure reads as a quiet action: a label and a chevron, no box. */
	.command-example {
		margin-top: var(--fn-space-5);
	}
	.command-example summary {
		display: inline-flex;
		align-items: center;
		gap: var(--fn-space-2);
		min-height: 44px;
		cursor: pointer;
		list-style: none;
		font-size: var(--fn-text-action);
		font-weight: 500;
		color: var(--fn-text);
	}
	.command-example summary:hover {
		text-decoration: underline;
		text-decoration-thickness: 1px;
	}
	.command-example summary::-webkit-details-marker {
		display: none;
	}
	.command-example summary::after {
		content: "";
		flex: none;
		width: 0.45em;
		height: 0.45em;
		border-right: 1.5px solid currentColor;
		border-bottom: 1.5px solid currentColor;
		transform: translateY(-25%) rotate(45deg);
	}
	.command-example[open] > summary::after {
		transform: translateY(25%) rotate(-135deg);
	}
	/* :global, because the content includes other components' root elements. */
	.command-example[open] > :global(:not(summary)) {
		margin-top: var(--fn-space-4);
	}
</style>
