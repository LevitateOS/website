---
import { docLink } from "../../lib/docs"
import { DEFAULT_DISTRO, FLAVORS, href, siblingHref, unprefixed, type DistroId } from "../../lib/flavor"
import { variantOf } from "../../lib/variants"

interface Props {
	distro?: DistroId
	/** Where the switch leads, when this page has no twin in the other flavour (the 404 page). */
	switchPath?: string
}

const { distro = DEFAULT_DISTRO, switchPath } = Astro.props
const path = unprefixed(Astro.url.pathname, distro)

function normalize(input: string): string {
	if (input === "/") return "/"
	return input.endsWith("/") ? input.slice(0, -1) : input
}

/** The page a nav item stands for, matched by its section where it has one. */
function isCurrent(item: { path: string; match?: string }): boolean {
	const current = normalize(path)
	const target = normalize(item.match ?? item.path)
	if (target === "/") return current === "/"
	return current === target || current.startsWith(`${target}/`)
}

// `path` is the LevitateOS (unprefixed) URL, used to tell which page is open.
const navItems = [
	{ path: "/download/", href: href("/download/", distro), label: "Downloads" },
	{ path: docLink("getting-started", "levitate"), href: docLink("getting-started", distro), label: "Docs", match: "/docs" },
	{ path: docLink("recipe-format", "levitate"), href: docLink("recipe-format", distro), label: "Recipes" },
	{ path: undefined, href: "https://github.com/LevitateOS/LevitateOS", label: "Source" },
]

// Recipes is a docs page; mark it current instead of Docs while it is open.
const onRecipes = normalize(path) === normalize(docLink("recipe-format", "levitate"))
function current(item: (typeof navItems)[number]): boolean {
	if (!item.path) return false
	if (item.label === "Docs" && onRecipes) return false
	return isCurrent({ path: item.path, match: item.match })
}

const switchHref = switchPath ?? siblingHref(Astro.url.pathname, distro)
const flavors = FLAVORS.map((flavor) => ({
	variant: variantOf(flavor.id),
	here: flavor.id === distro,
	to: flavor.id === distro ? href("/", distro) : switchHref,
	label: flavor.id === distro ? `${flavor.osName} home` : `Switch to ${flavor.osName}`,
}))
---

<header class="site-head">
	<div class="wrap head-row">
		<div class="head-switch">
			{flavors.map(({ variant, here, to, label }, index) => (
				<>
					{index > 0 && <span class="head-switch__rule" aria-hidden="true" />}
					<a
						class:list={["head-brand", { "head-brand--other": !here }]}
						href={to}
						aria-label={label}
						aria-current={here ? "true" : undefined}
					>
						<span class="head-brand__lockup">
							<img class="logo-light" src={variant.lockup.light} width={variant.lockup.width} height="40" alt="" />
							<img class="logo-dark" src={variant.lockup.dark} width={variant.lockup.width} height="40" alt="" />
						</span>
						{!here && (
							<span class="head-brand__mark">
								<img class="logo-light" src={variant.mark.light} width="24" height="24" alt="" />
								<img class="logo-dark" src={variant.mark.dark} width="24" height="24" alt="" />
							</span>
						)}
					</a>
				</>
			))}
		</div>

		<nav class="head-nav" aria-label="Main">
			<ul>
				{navItems.map((item) => (
					<li>
						<a class="nav-link" href={item.href} aria-current={current(item) ? "page" : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
	</div>

	<nav class="mobile-menu" id="mobile-menu" aria-label="Main">
		<ul class="wrap">
			{navItems.map((item) => (
				<li>
					<a class="nav-link" href={item.href} aria-current={current(item) ? "page" : undefined}>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<script>
	// Compact navigation: a disclosure that expands in the page flow. Without JavaScript
	// the list is simply shown.
	const toggle = document.getElementById("menu-toggle")
	const menu = document.getElementById("mobile-menu")
	function setOpen(open: boolean) {
		toggle?.setAttribute("aria-expanded", String(open))
		menu?.classList.toggle("is-open", open)
	}
	toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"))
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return
		const inside = menu?.contains(document.activeElement) || document.activeElement === toggle
		setOpen(false)
		if (inside) toggle?.focus()
	})
</script>
