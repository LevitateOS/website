---
import { docLink } from "../../lib/docs"

const path = Astro.url.pathname

function normalize(input: string): string {
	if (input === "/") return "/"
	return input.endsWith("/") ? input.slice(0, -1) : input
}

/** The page a nav item stands for, matched by its section where it has one. */
function isCurrent(item: { href: string; match?: string }): boolean {
	const current = normalize(path)
	const target = normalize(item.match ?? item.href)
	if (target === "/") return current === "/"
	return current === target || current.startsWith(`${target}/`)
}

const navItems = [
	{ href: "/download/", label: "Downloads" },
	{ href: docLink("getting-started"), label: "Docs", match: "/docs" },
	{ href: docLink("recipe-format"), label: "Recipes" },
	{ href: "https://github.com/LevitateOS/LevitateOS", label: "Source" },
]

// Recipes is a docs page; mark it current instead of Docs while it is open.
const onRecipes = normalize(path) === normalize(docLink("recipe-format"))
function current(item: (typeof navItems)[number]): boolean {
	if (item.label === "Docs" && onRecipes) return false
	return isCurrent(item)
}
---

<header class="site-head">
	<div class="wrap head-row">
		<a class="head-brand" href="/" aria-label="LevitateOS home">
			<img class="logo-light" src="/brand/levitate-lockup-ink.svg" width="213" height="40" alt="" />
			<img class="logo-dark" src="/brand/levitate-lockup-paper.svg" width="213" height="40" alt="" />
		</a>

		<nav class="head-nav" aria-label="Main">
			<ul>
				{navItems.map((item) => (
					<li>
						<a class="nav-link" href={item.href} aria-current={current(item) ? "page" : undefined}>
							{item.label}
						</a>
					</li>
				))}
			</ul>
		</nav>

		<button type="button" class="menu-toggle" id="menu-toggle" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
	</div>

	<nav class="mobile-menu" id="mobile-menu" aria-label="Main">
		<ul class="wrap">
			{navItems.map((item) => (
				<li>
					<a class="nav-link" href={item.href} aria-current={current(item) ? "page" : undefined}>
						{item.label}
					</a>
				</li>
			))}
		</ul>
	</nav>
</header>

<script>
	// Compact navigation: a disclosure that expands in the page flow. Without JavaScript
	// the list is simply shown.
	const toggle = document.getElementById("menu-toggle")
	const menu = document.getElementById("mobile-menu")
	function setOpen(open: boolean) {
		toggle?.setAttribute("aria-expanded", String(open))
		menu?.classList.toggle("is-open", open)
	}
	toggle?.addEventListener("click", () => setOpen(toggle.getAttribute("aria-expanded") !== "true"))
	document.addEventListener("keydown", (event) => {
		if (event.key !== "Escape" || toggle?.getAttribute("aria-expanded") !== "true") return
		const inside = menu?.contains(document.activeElement) || document.activeElement === toggle
		setOpen(false)
		if (inside) toggle?.focus()
	})
</script>
