---
import { docsNav, contentBySlug } from "@levitate/docs-content/live"
import { toAnchor } from "../../lib/anchor"

interface Props {
	currentSlug: string
}

const { currentSlug } = Astro.props
const currentPath = `/docs/${currentSlug}`
const currentTitle =
	docsNav.flatMap((section) => section.items).find((item) => item.href === currentPath)?.title || "Documentation"

// Only long pages get an in-page contents list under their nav entry.
const MIN_SECTIONS_FOR_CONTENTS = 4
---

{/* One navigation, rendered twice: a column on wide screens, a disclosure before the article on compact ones. */}
{[false, true].map((compact) => {
	const nav = (
		<nav class="docs-nav" aria-label={compact ? "Documentation (compact)" : "Documentation"}>
			{docsNav.map((section) => (
				<section>
					<h2>{section.title}</h2>
					<ul>
						{section.items.map((item) => {
							const isActive = currentPath === item.href
							const sections = contentBySlug[item.href.replace("/docs/", "")]?.sections ?? []
							const showContents = !compact && isActive && sections.length >= MIN_SECTIONS_FOR_CONTENTS
							return (
								<li>
									<a href={item.href} aria-current={isActive ? "page" : undefined}>{item.title}</a>
									{showContents && (
										<ul class="docs-nav__sub" aria-label="On this page">
											{sections.filter((s) => (s.level ?? 2) === 2).map((s) => (
												<li><a href={`#${toAnchor(s.title)}`}>{s.title}</a></li>
											))}
										</ul>
									)}
								</li>
							)
						})}
					</ul>
				</section>
			))}
		</nav>
	)
	return compact ? (
		<details class="docs-nav-compact">
			<summary><span>Docs: {currentTitle}</span></summary>
			{nav}
		</details>
	) : nav
})}
