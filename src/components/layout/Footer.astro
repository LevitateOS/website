---
const year = new Date().getFullYear()

const columns = [
	{
		title: "Getting started",
		links: [
			{ href: "/docs/getting-started/", label: "Overview" },
			{ href: "/docs/installation/", label: "Installation guide" },
			{ href: "/docs/post-installation/", label: "After installing" },
			{ href: "/docs/troubleshooting/", label: "Troubleshooting" },
		],
	},
	{
		title: "Recipes",
		links: [
			{ href: "/docs/cli-reference/", label: "CLI reference" },
			{ href: "/docs/recipe-format/", label: "Recipe format" },
			{ href: "/docs/helpers-overview/", label: "Rhai helpers" },
			{ href: "/docs/atomic-updates/", label: "Atomic updates" },
		],
	},
	{
		title: "Tooling",
		links: [
			{ href: "/docs/recpart/", label: "recpart" },
			{ href: "/docs/recstrap/", label: "recstrap" },
			{ href: "/docs/recsetup/", label: "recsetup" },
			{ href: "/docs/recab/", label: "recab" },
			{ href: "/docs/rec-tooling-overview/", label: "All tools" },
		],
	},
]
---

<footer class="site-foot">
	<div class="wrap">
		<div class="foot-grid">
			<div class="foot-brand">
				<img class="logo-light" src="/brand/levitate-lockup-color.svg" width="177" height="32" alt="LevitateOS" />
				<img class="logo-dark" src="/brand/levitate-lockup-reversed.svg" width="177" height="32" alt="LevitateOS" />
				<p class="muted">Be your own package maintainer.</p>
			</div>
			{columns.map((column) => (
				<nav aria-labelledby={`foot-${column.title.toLowerCase().replace(/\s+/g, "-")}`}>
					<h2 id={`foot-${column.title.toLowerCase().replace(/\s+/g, "-")}`}>{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			))}
		</div>

		<div class="foot-base">
			<div class="foot-links">
				<span class="muted">&copy; {year} LevitateOS</span>
				<a href="/privacy/">Privacy</a>
				<a href="https://github.com/LevitateOS/LevitateOS/issues">Report an issue</a>
				<a href="https://github.com/LevitateOS/LevitateOS/blob/master/LICENSE">MIT or Apache-2.0</a>
			</div>
			<div class="appearance">
				<label for="appearance">Appearance</label>
				<select id="appearance" name="appearance">
					<option value="system">System</option>
					<option value="light">Light</option>
					<option value="dark">Dark</option>
				</select>
			</div>
		</div>
	</div>
</footer>

<script>
	// System follows the OS; an explicit Light or Dark choice wins and is kept locally.
	// Without storage the choice lasts for this page only.
	const select = document.getElementById("appearance") as HTMLSelectElement | null
	const root = document.documentElement
	if (select) {
		const current = root.dataset.theme
		select.value = current === "light" || current === "dark" ? current : "system"
		select.addEventListener("change", () => {
			root.dataset.theme = select.value
			try {
				localStorage.setItem("appearance", select.value)
			} catch {
				// Storage unavailable: keep the choice in memory only.
			}
		})
	}
</script>
