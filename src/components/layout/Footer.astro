---
import { docLink } from "../../lib/docs"
import { variantOf } from "../../lib/variants"
import { DEFAULT_DISTRO, distroName, href, type DistroId } from "../../lib/flavor"

interface Props {
	distro?: DistroId
}

const { distro = DEFAULT_DISTRO } = Astro.props
const osName = distroName(distro)
const { lockup: lockupArt } = variantOf(distro)
const lockup = { src: lockupArt.dark, width: Math.round((lockupArt.width * 28) / 40) }

const year = new Date().getFullYear()

const columns = [
	{
		title: "Getting started",
		links: [
			{ href: docLink("getting-started", distro), label: "Overview" },
			{ href: docLink("installation", distro), label: `Installing ${osName}` },
			{ href: docLink("post-installation", distro), label: "After installing" },
			{ href: docLink("troubleshooting", distro), label: "Troubleshooting" },
		],
	},
	{
		title: "Recipes",
		links: [
			{ href: docLink("cli-reference", distro), label: "CLI reference" },
			{ href: docLink("recipe-format", distro), label: "Recipe format" },
			{ href: docLink("helpers-overview", distro), label: "Rhai helpers" },
			{ href: docLink("atomic-updates", distro), label: "Atomic updates" },
		],
	},
	{
		title: "Tooling",
		links: [
			{ href: docLink("recpart", distro), label: "recpart" },
			{ href: docLink("recstrap", distro), label: "recstrap" },
			{ href: docLink("recsetup", distro), label: "recsetup" },
			{ href: docLink("recab", distro), label: "recab" },
			{ href: docLink("rec-tooling-overview", distro), label: "All tools" },
		],
	},
]
---

<footer class="site-foot">
	<div class="wrap">
		<div class="foot-grid">
			<div class="foot-brand">
				<img src={lockup.src} width={lockup.width} height="28" alt={osName} />
				<p>Be your own package maintainer.</p>
			</div>
			{columns.map((column) => (
				<nav aria-labelledby={`foot-${column.title.toLowerCase().replace(/\s+/g, "-")}`}>
					<h2 id={`foot-${column.title.toLowerCase().replace(/\s+/g, "-")}`}>{column.title}</h2>
					<ul>
						{column.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</nav>
			))}
		</div>

		<div class="foot-base">
			<div class="foot-links">
				<span>&copy; {year} LevitateOS</span>
				<a href={href("/privacy/", distro)}>Privacy</a>
				<a href="https://github.com/LevitateOS/LevitateOS/issues">Report an issue</a>
				<a href="https://github.com/LevitateOS/LevitateOS/blob/master/LICENSE">MIT or Apache-2.0</a>
			</div>
			<div class="appearance">
				<label for="appearance">Appearance</label>
				<select id="appearance" name="appearance">
					<option value="system">System</option>
					<option value="light">Light</option>
					<option value="dark">Dark</option>
				</select>
			</div>
		</div>
	</div>
</footer>

<script>
	// System follows the OS; an explicit Light or Dark choice wins and is kept locally.
	// Without storage the choice lasts for this page only.
	const select = document.getElementById("appearance") as HTMLSelectElement | null
	const root = document.documentElement
	if (select) {
		const current = root.dataset.theme
		select.value = current === "light" || current === "dark" ? current : "system"
		select.addEventListener("change", () => {
			root.dataset.theme = select.value
			try {
				localStorage.setItem("appearance", select.value)
			} catch {
				// Storage unavailable: keep the choice in memory only.
			}
		})
	}
</script>
