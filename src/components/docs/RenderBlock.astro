---
import type { ContentBlock } from "@levitate/docs-content"
import TextBlock from "./TextBlock.astro"
import CommandBlockComponent from "./CommandBlock.astro"
import TableBlock from "./TableBlock.astro"
import ListBlock from "./ListBlock.astro"
import InteractiveBlock from "./InteractiveBlock.astro"
import QABlock from "./QABlock.astro"
import NoteBlock from "./NoteBlock.astro"
import CodeBlock from "../CodeBlock.astro"

interface Props {
	block: ContentBlock
}

const { block } = Astro.props

// Every block kind has a branch below; a new kind fails the typecheck here instead of
// rendering as nothing.
const RENDERED = ["text", "code", "table", "list", "interactive", "command", "qa", "note"] as const
type Unrendered = Exclude<ContentBlock["type"], (typeof RENDERED)[number]>
const everyKind: [Unrendered] extends [never] ? true : Unrendered = true
if (!RENDERED.includes(block.type) || !everyKind) throw new Error(`unknown block type ${block.type}`)
---

<div class="docs-block">
{
	block.type === "text" && <TextBlock content={block.content} />
}
{
	block.type === "code" && (
		<CodeBlock
			code={block.content}
			language={block.language}
			label={block.filename}
		/>
	)
}
{
	block.type === "table" && <TableBlock table={block} />
}
{
	block.type === "list" && <ListBlock list={block} />
}
{
	block.type === "interactive" && (
		<InteractiveBlock block={block} />
	)
}
{
	block.type === "command" && (
		<CommandBlockComponent block={block} />
	)
}
{
	block.type === "qa" && <QABlock block={block} />
}
{
	block.type === "note" && <NoteBlock block={block} />
}
</div>
