---
import { docsNav, plainText, type DocsContent, type Section, type ContentBlock } from "@levitate/docs-content"
import DocsLayout from "../layout/DocsLayout.astro"
import InlineContent from "./InlineContent.astro"
import RenderBlock from "./RenderBlock.astro"
import ImageFrame from "../ImageFrame.astro"
import Screenshot from "../Screenshot.astro"
import { docsScreenshots, type ScreenshotId } from "../../lib/screenshots"
import { toAnchor } from "../../lib/anchor"
import { docsHref, isDistroPage } from "../../lib/docs"
import { DEFAULT_DISTRO, distroName, type DistroId } from "../../lib/flavor"

interface Props {
	content: DocsContent
	slug: string
	/** The flavour this version of the page is for. */
	distro?: DistroId
}

const { content, slug, distro = DEFAULT_DISTRO } = Astro.props

/** The text cut at the last word boundary within `max` characters, with an ellipsis when something was cut. */
function excerpt(text: string, max: number): string {
	if (text.length <= max) return text
	const cut = text.slice(0, max + 1)
	const words = cut.slice(0, cut.search(/\s\S*$/) > 0 ? cut.search(/\s\S*$/) : max)
	return `${words.replace(/[\s.,;:!?\-–—]+$/, "")}…`
}

const description = content.intro ? excerpt(plainText(content.intro), 160) : undefined
const pages = docsNav.flatMap((section) => section.items)
const at = pages.findIndex((page) => page.slug === slug)
const previous = at > 0 ? pages[at - 1] : undefined
const next = at >= 0 ? pages[at + 1] : undefined
const eyebrow = isDistroPage(slug) ? `${distroName(distro)} documentation` : "Documentation"
const illustrations: Record<string, readonly ScreenshotId[]> = docsScreenshots[slug as keyof typeof docsScreenshots] ?? {}
---

<DocsLayout title={content.title} currentSlug={slug} distro={distro} description={description}>
	{slug === "getting-started" ? (
		<ImageFrame art="paper" class="frame-host--inset frame-host--compact frame-host--docs">
			<div>
				<p class="eyebrow">{eyebrow}</p>
				<h1>{content.title}</h1>
				{content.intro && <p class="docs-intro"><InlineContent content={content.intro} /></p>}
			</div>
		</ImageFrame>
	) : (
		<>
			<p class="eyebrow">{eyebrow}</p>
			<h1>{content.title}</h1>
			{content.intro && <p class="docs-intro"><InlineContent content={content.intro} /></p>}
		</>
	)}
	{slug === "getting-started" && <Screenshot id="desktop-recipe" distro={distro} />}
	{content.sections.map((section: Section) => {
		const level = section.level ?? 2
		const anchor = toAnchor(section.title)
		return (
			<section id={anchor} class:list={["docs-section", { "docs-section--sub": level !== 2 }]}>
				{level === 2 ? (
					<h2><a class="docs-heading-anchor" href={`#${anchor}`}>{section.title}</a></h2>
				) : (
					<h3><a class="docs-heading-anchor" href={`#${anchor}`}>{section.title}</a></h3>
				)}
				{section.content.map((block: ContentBlock) => <RenderBlock block={block} />)}
				{illustrations[anchor]?.map((id) => <Screenshot id={id} distro={distro} />)}
			</section>
		)
	})}
	{(previous || next) && (
		<nav class="docs-pager" aria-label="Previous and next page">
			{previous && (
				<a class="docs-pager__prev" rel="prev" href={docsHref(previous.slug, distro)}>
					<span class="docs-pager__label">Previous</span>
					<span class="docs-pager__title">{previous.title}</span>
				</a>
			)}
			{next && (
				<a class="docs-pager__next" rel="next" href={docsHref(next.slug, distro)}>
					<span class="docs-pager__label">Next</span>
					<span class="docs-pager__title">{next.title}</span>
				</a>
			)}
		</nav>
	)}
</DocsLayout>
