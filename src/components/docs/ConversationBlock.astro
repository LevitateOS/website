---
import type { ConversationBlock } from "@levitate/docs-content"
import InlineContent from "./InlineContent.astro"

interface Props {
	conversation: ConversationBlock
}

const { conversation } = Astro.props
---

<div class="docs-transcript">
	{conversation.messages.map((msg) => (
		<div>
			<span class="docs-transcript__role">{msg.role === "user" ? "User" : "Assistant"}</span>
			<InlineContent content={msg.text} />
			{msg.list && (
				<ul class="docs-list">
					{msg.list.map((item) => (
						<li><InlineContent content={item} /></li>
					))}
				</ul>
			)}
		</div>
	))}
</div>
