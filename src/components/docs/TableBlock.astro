---
import type { TableBlock } from "@levitate/docs-content"
import InlineContent from "./InlineContent.astro"

interface Props {
	table: TableBlock
}

const { table } = Astro.props
---

<div class="table-scroll" role="region" tabindex="0" aria-label="Table">
	<table class="data-table">
		<thead>
			<tr>
				{table.headers.map((header) => (
					<th scope="col"><InlineContent content={header} /></th>
				))}
			</tr>
		</thead>
		<tbody>
			{table.rows.map((row) => (
				<tr>
					{row.map((cell, j) => (
						<td class:list={{ "is-mono": j === table.monospaceCol }}><InlineContent content={cell} /></td>
					))}
				</tr>
			))}
		</tbody>
	</table>
</div>
