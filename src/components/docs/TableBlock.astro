---
import { plainText, type TableBlock } from "@levitate/docs-content"
import InlineContent from "./InlineContent.astro"

interface Props {
	table: TableBlock
}

const { table } = Astro.props
const headers = table.headers.map(plainText).filter((text) => text.trim() !== "")
const regionLabel = headers.length ? `Table: ${headers.join(", ")}` : "Table"
---

<div class="table-scroll" role="region" tabindex="0" aria-label={regionLabel}>
	<table class="data-table">
		<thead>
			<tr>
				{table.headers.map((header) => (
					<th scope="col"><InlineContent content={header} /></th>
				))}
			</tr>
		</thead>
		<tbody>
			{table.rows.map((row) => (
				<tr>
					{row.map((cell, j) => (
						<td class:list={{ "is-mono": j === table.monospaceCol }}><InlineContent content={cell} /></td>
					))}
				</tr>
			))}
		</tbody>
	</table>
</div>
