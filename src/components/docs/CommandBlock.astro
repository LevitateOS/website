---
import type { CommandBlock } from "@levitate/docs-content"
import CodeBlock from "../CodeBlock.astro"

interface Props {
	block: CommandBlock
}

const { block } = Astro.props
const commandText = Array.isArray(block.command) ? block.command.join("\n") : block.command
---

<CodeBlock code={commandText} language={block.language ?? "bash"} label={block.description} output={block.output} />
