---
import type { NoteBlock } from "@levitate/docs-content"
import InlineContent from "./InlineContent.astro"

interface Props {
	block: NoteBlock
}

const { block } = Astro.props

const variantClasses: Record<NoteBlock["variant"], string> = {
	info: "",
	warning: "callout--warning",
	danger: "callout--error",
}

const variantLabel: Record<NoteBlock["variant"], string> = {
	info: "Note",
	warning: "Warning",
	danger: "Caution",
}
---

<div class:list={["callout", variantClasses[block.variant]]}>
	<strong class="callout__label">{variantLabel[block.variant]}</strong>
	<div><InlineContent content={block.content} /></div>
</div>
