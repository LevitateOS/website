---
import type { InteractiveBlock } from "@levitate/docs-content"
import InlineContent from "./InlineContent.astro"

interface Props {
	block: InteractiveBlock
}

const { block } = Astro.props
---

<div>
	{block.intro && (
		<p><InlineContent content={block.intro} /></p>
	)}
	<ol class="docs-steps">
		{block.steps.map((step, index) => (
			<li>
				<span class="docs-steps__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
				<div>
					<code class="inline-code">{step.command}</code>
					<p><InlineContent content={step.description} /></p>
				</div>
			</li>
		))}
	</ol>
</div>
