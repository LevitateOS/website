---
import { Code } from "astro:components"
import type { ShikiTransformer } from "shiki"

interface Note {
	/** 1-based line the note points at. Keep notes at least three lines apart. */
	line: number
	text: string
}

interface Props {
	code: string
	/** Shiki language; rhai is highlighted with the Rust grammar. */
	language: string
	/** File name or short description shown in the bar above the code. */
	label?: string
	/** Where the example comes from, shown quietly after the label. */
	source?: string
	/** Text the copy button copies, when it differs from the shown code. */
	copyText?: string
	/** Command output shown under the code. */
	output?: string
	/** Margin notes, each pointing at one line: the specimen's annotations. */
	notes?: Note[]
}

const { code, language, label, source, copyText, output, notes = [] } = Astro.props
const lang = language === "rhai" ? "rust" : language
const isShell = ["bash", "sh", "shell", "console", "zsh"].includes(language)

// Shell lines that start a command get a prompt drawn in CSS, so Copy never
// copies it. Comments, blank lines and continuations get none.
const commandLines = new Set<number>()
if (isShell) {
	let continued = false
	code.split("\n").forEach((text, index) => {
		const trimmed = text.trim()
		if (!continued && trimmed !== "" && !trimmed.startsWith("#")) commandLines.add(index + 1)
		continued = trimmed.endsWith("\\")
	})
}
const transformers: ShikiTransformer[] = [
	{
		line(node, line) {
			if (commandLines.has(line)) this.addClassToHast(node, "is-command")
		},
	},
]

const ordered = [...notes].sort((a, b) => a.line - b.line)
const number = (index: number) => String(index + 1).padStart(2, "0")
const regionLabel = label ? `Code: ${label}` : `${language} code`
---

<div class="code-specimen" data-annotated={ordered.length ? "" : undefined}>
	<div class="code-specimen__grid">
		<div class="code-shell" data-kind={isShell ? "shell" : "file"}>
			<div class="code-head">
				<span class="code-head__label">
					{label && <span class="code-head__name">{label}</span>}
					{source && <span class="code-head__source">{source}</span>}
				</span>
				<button type="button" class="copy-button" data-code={copyText ?? code} aria-label={label ? `Copy ${label}` : "Copy code"}>Copy</button>
			</div>
			<div class="code-body">
				<div role="region" tabindex="0" aria-label={regionLabel} class="code-region">
					<Code code={code} lang={lang as any} theme="css-variables" transformers={transformers} />
				</div>
				{ordered.length > 0 && (
					<div class="code-marks" aria-hidden="true">
						{ordered.map((note, index) => <span class="code-mark" style={`--line: ${note.line}`}><span>{number(index)}</span></span>)}
					</div>
				)}
			</div>
			{output && (
				<div class="code-output">
					<p class="code-output__label">Output</p>
					<pre>{output}</pre>
				</div>
			)}
		</div>
		{ordered.length > 0 && (
			<ol class="code-notes" aria-label={label ? `Notes on ${label}` : "Notes on the code"}>
				{ordered.map((note, index) => (
					<li style={`--line: ${note.line}`}>
						<span class="code-notes__n">{number(index)}</span>
						<span class="sr-only">Line {note.line}: </span>
						<span class="code-notes__text">{note.text}</span>
					</li>
				))}
			</ol>
		)}
	</div>
</div>

<script>
	import { bindCopyButtons } from "../scripts/copyButtons"
	bindCopyButtons()
</script>
