---
import { Code } from "astro:components"
import type { ShikiTransformer } from "shiki"

interface Props {
	code: string
	/** Shiki language; rhai is highlighted with the Rust grammar. */
	language: string
	/** File name or short description shown in the bar above the code. */
	label?: string
	/** Where the example comes from, shown quietly after the label. */
	source?: string
	/** Text the copy button copies, when it differs from the shown code. */
	copyText?: string
	/** Command output shown under the code. */
	output?: string
}

const { code, language, label, source, copyText, output } = Astro.props
const lang = language === "rhai" ? "rust" : language

// Shell examples are typed at a prompt; anything else is a file with line numbers.
const isShell = ["bash", "sh", "shell", "console", "zsh"].includes(language)
const kind = isShell ? "Shell" : language.length <= 4 ? language.toUpperCase() : language[0].toUpperCase() + language.slice(1)
const lines = code.split("\n")
const numbered = !isShell && lines.length > 3

// Mark the lines that start a command, so CSS can draw a prompt the copy button
// never copies. Comments, blank lines and continuations of a previous line get none.
const commandLines = new Set<number>()
const commentLines = new Set<number>()
if (isShell) {
	let continued = false
	lines.forEach((text, index) => {
		const trimmed = text.trim()
		if (trimmed.startsWith("#")) commentLines.add(index + 1)
		else if (!continued && trimmed !== "") commandLines.add(index + 1)
		continued = trimmed.endsWith("\\")
	})
}
const transformers: ShikiTransformer[] = [
	{
		line(node, line) {
			if (commandLines.has(line)) this.addClassToHast(node, "is-command")
			if (commentLines.has(line)) this.addClassToHast(node, "is-comment")
		},
	},
]

const regionLabel = label ? `Code: ${label}` : `${kind} code`
---

<div class="code-shell" data-kind={isShell ? "shell" : "file"} data-numbered={numbered ? "" : undefined}>
	<div class="code-head">
		<span class="code-head__kind">{kind}</span>
		<span class="code-head__label">
			{label && <span class="code-head__name">{label}</span>}
			{source && <span class="code-head__source">{source}</span>}
		</span>
		<button type="button" class="copy-button" data-code={copyText ?? code} aria-label={label ? `Copy ${label}` : "Copy code"}>Copy</button>
	</div>
	<div role="region" tabindex="0" aria-label={regionLabel} class="code-region">
		<Code code={code} lang={lang as any} theme="css-variables" transformers={transformers} />
	</div>
	{output && (
		<div class="code-output">
			<p class="code-output__label">Output</p>
			<pre>{output}</pre>
		</div>
	)}
</div>

<script>
	import { bindCopyButtons } from "../scripts/copyButtons"
	bindCopyButtons()
</script>
